---
import Base from '../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { FORM_ENDPOINT } from '../config';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Base title={t.nav.contact} description="Contact GANA R&D — distributors, clinics, hospitals and brand partners.">
  <header class="container page-head">
    <p class="ph-eyebrow hero-fade d1">{t.contact.eyebrow}</p>
    <h1><span class="hero-line"><span>{t.contact.title}</span></span></h1>
    <p class="ph-sub hero-fade d2">{t.contact.sub}</p>
  </header>

  <section class="container section tight">
    <div class="split top">
      <form
        class="form"
        method="post"
        action={FORM_ENDPOINT || undefined}
        data-endpoint={FORM_ENDPOINT}
        data-reveal
      >
        <div class="row2">
          <label>{t.contact.formName}<input type="text" name="name" required /></label>
          <label>{t.contact.formCompany}<input type="text" name="company" /></label>
        </div>
        <div class="row2">
          <label>{t.contact.formEmail}<input type="email" name="email" required /></label>
          <label>{t.contact.formPhone}<input type="tel" name="phone" /></label>
        </div>
        <div class="row2">
          <label>{t.contact.formCountry}<input type="text" name="country" /></label>
          <label>{t.contact.formType}
            <select name="type">
              {t.contact.formTypes.map((ft) => <option>{ft}</option>)}
            </select>
          </label>
        </div>
        <label>{t.contact.formMessage}<textarea name="message" rows="6" required></textarea></label>
        <!-- 스팸 봇용 허니팟 — 사람 눈에는 안 보인다 -->
        <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button
          class="btn"
          type="submit"
          data-send={t.contact.formSend}
          data-sending={t.contact.formSending}
        >{t.contact.formSend}</button>
        <p
          class="form-status muted small"
          role="status"
          aria-live="polite"
          data-success={t.contact.formSuccess}
          data-error={t.contact.formError}
        >{FORM_ENDPOINT ? '' : t.contact.formNote}</p>
      </form>
      <div class="side" data-reveal="right">
        <p class="eyebrow">{t.contact.sideEyebrow}</p>
        <address>
          GANA R&amp;D Co., Ltd.<br />
          555 Dunchon-daero, Jungwon-gu,<br />
          Seongnam-si, Gyeonggi-do 13215<br />
          Republic of Korea<br />
          Tel +82-31-733-0242
        </address>
        <p class="muted small" style="margin-top: var(--s6)">{t.contact.sideNote}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .split.top { align-items: start; }
  .form { display: flex; flex-direction: column; gap: var(--s4); }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s4); }
  label { display: flex; flex-direction: column; gap: var(--s2); font-size: var(--text-sm); font-weight: 600; color: var(--ink-2); }
  input, select, textarea { font: inherit; font-weight: 400; color: var(--ink); padding: 11px 12px; border: 1px solid var(--line); border-radius: 2px; background: #fff; transition: border-color 300ms var(--ease-out-expo), box-shadow 300ms var(--ease-out-expo); }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12); }
  address { font-style: normal; line-height: 1.8; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .form-status:not(:empty) { padding-top: var(--s2); }
  .form-status.is-success { color: var(--ok); }
  .form-status.is-error { color: var(--warn); }
  @media (max-width: 640px) { .row2 { grid-template-columns: 1fr; } }
</style>

<script>
  // 문의 폼 전송 — FORM_ENDPOINT(JSON 응답 엔드포인트)로 AJAX POST.
  // 엔드포인트 미설정이면 제출을 막고 우측 주소 안내를 유지한다.
  const form = document.querySelector<HTMLFormElement>('form.form');
  if (form) {
    const endpoint = form.dataset.endpoint ?? '';
    const status = form.querySelector<HTMLElement>('.form-status');
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status || !btn) return;
      if (!endpoint) {
        status.textContent = status.dataset.error ?? '';
        status.classList.add('is-error');
        return;
      }
      if ((form.elements.namedItem('_honey') as HTMLInputElement)?.value) return;
      btn.disabled = true;
      btn.textContent = btn.dataset.sending ?? btn.textContent;
      status.classList.remove('is-success', 'is-error');
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        status.textContent = status.dataset.success ?? '';
        status.classList.add('is-success');
        form.reset();
      } catch {
        status.textContent = status.dataset.error ?? '';
        status.classList.add('is-error');
      } finally {
        btn.disabled = false;
        btn.textContent = btn.dataset.send ?? btn.textContent;
      }
    });
  }
</script>
