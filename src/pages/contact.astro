---
import Base from '../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { FORM_ENDPOINT_B64 } from '../config';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Base title={t.nav.contact} description={t.meta.contact}>
  <header class="container page-head photo" style="--ph-img: url('/images/head-contact.webp')">
    <p class="ph-eyebrow hero-fade d1">{t.contact.eyebrow}</p>
    <h1><span class="hero-line"><span>{t.contact.title}</span></span></h1>
    <p class="ph-sub hero-fade d2">{t.contact.sub}</p>
  </header>

  <section class="container section tight">
    <div class="split top">
      <form
        class="form"
        method="post"
        data-ep={FORM_ENDPOINT_B64}
        data-reveal
      >
        <div class="row2">
          <label>{t.contact.formName}<input type="text" name="name" required /></label>
          <label>{t.contact.formCompany}<input type="text" name="company" /></label>
        </div>
        <div class="row2">
          <label>{t.contact.formEmail}<input type="email" name="email" required /></label>
          <label>{t.contact.formPhone}<input type="tel" name="phone" /></label>
        </div>
        <div class="row2">
          <label>{t.contact.formCountry}<input type="text" name="country" /></label>
          <label>{t.contact.formType}
            <select name="type">
              {t.contact.formTypes.map((ft) => <option>{ft}</option>)}
            </select>
          </label>
        </div>
        <label>{t.contact.formMessage}<textarea name="message" rows="6" required></textarea></label>
        <!-- 스팸 봇용 허니팟 — 사람 눈에는 안 보인다 -->
        <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <!-- FormSubmit 설정: 받은편지함에서 표로 보이게, 제목 고정 -->
        <input type="hidden" name="_subject" value="[GANA R&D] Website enquiry" />
        <input type="hidden" name="_template" value="table" />
        <button
          class="btn"
          type="submit"
          data-send={t.contact.formSend}
          data-sending={t.contact.formSending}
        >{t.contact.formSend}</button>
        <p
          class="form-status muted small"
          role="status"
          aria-live="polite"
          data-success={t.contact.formSuccess}
          data-error={t.contact.formError}
        >{FORM_ENDPOINT_B64 ? '' : t.contact.formNote}</p>
      </form>
      <div class="side" data-reveal="right">
        <p class="eyebrow">{t.contact.sideEyebrow}</p>
        <address>
          {t.footer.legalName}<br />
          {t.footer.addr1}<br />
          {t.footer.addr2}<br />
          {t.footer.tel}
        </address>
        <p class="muted small" style="margin-top: var(--s6)">{t.contact.sideNote}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .split.top { grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr); gap: 0; align-items: stretch; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; box-shadow: var(--shadow-sm); }
  .form { display: flex; flex-direction: column; gap: var(--s5); padding: clamp(30px, 5vw, 68px); }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s4); }
  label { display: flex; flex-direction: column; gap: var(--s2); font-size: var(--text-xs); font-weight: 700; letter-spacing: .04em; color: var(--ink-2); }
  input, select, textarea { width: 100%; min-height: 52px; font: inherit; font-weight: 400; color: var(--ink); padding: 13px 14px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--paper-2); transition: border-color 220ms var(--ease), background 220ms var(--ease), box-shadow 220ms var(--ease); }
  textarea { min-height: 160px; resize: vertical; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); background: #fff; box-shadow: 0 0 0 3px rgba(154,128,80,.12); }
  .form .btn { margin-top: var(--s2); align-self: flex-start; }
  .side { padding: clamp(30px, 5vw, 68px); background: var(--navy); color: rgba(255,255,255,.72); }
  .side .eyebrow { color: rgba(255,255,255,.56); }
  .side address { color: #fff; }
  .side .muted { color: rgba(255,255,255,.58); }
  address { font-style: normal; line-height: 1.9; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .form-status:not(:empty) { padding-top: var(--s2); }
  .form-status.is-success { color: var(--ok); }
  .form-status.is-error { color: var(--warn); }
  @media (max-width: 900px) { .split.top { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .row2 { grid-template-columns: 1fr; } .form .btn { width: 100%; } }
</style>

<script>
  // 문의 폼 전송 — FORM_ENDPOINT(JSON 응답 엔드포인트)로 AJAX POST.
  // 엔드포인트 미설정이면 제출을 막고 우측 주소 안내를 유지한다.
  const form = document.querySelector<HTMLFormElement>('form.form');
  if (form) {
    // 엔드포인트는 base64로 실려 온다(이메일 수집기 회피). action 속성은 일부러 없다 — JS 전송만 허용.
    const endpoint = form.dataset.ep ? atob(form.dataset.ep) : '';
    const status = form.querySelector<HTMLElement>('.form-status');
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status || !btn) return;
      if (!endpoint) {
        status.textContent = status.dataset.error ?? '';
        status.classList.add('is-error');
        return;
      }
      if ((form.elements.namedItem('_honey') as HTMLInputElement)?.value) return;
      btn.disabled = true;
      btn.textContent = btn.dataset.sending ?? btn.textContent;
      status.classList.remove('is-success', 'is-error');
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        status.textContent = status.dataset.success ?? '';
        status.classList.add('is-success');
        form.reset();
      } catch {
        status.textContent = status.dataset.error ?? '';
        status.classList.add('is-error');
      } finally {
        btn.disabled = false;
        btn.textContent = btn.dataset.send ?? btn.textContent;
      }
    });
  }
</script>
