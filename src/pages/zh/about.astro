---
// About — "회사 소개"가 아니라 제조자 신원 확인 페이지. 등록증의 제조자명을 보고 들어온 바이어·규제 담당자가 "이 회사가 맞나"를 확인하는 자리.
// 구성: 법인 신원 → 무엇을 만드는가 → 자격 4건(공개 조회 링크) → 제조소 사진 → 창업자 → 연혁 → Dr. Park Group 관계 → CTA
// 금지: 비전·미션 문구, 효능 주장, 시술 전후 사진, 생산능력 수치(회장 결정 전), "Since 2013", KoraVie 2건, 기업집단·자회사 표현.
import Base from '../../layouts/Base.astro';
import PhotoSlot from '../../components/PhotoSlot.astro';
import { counts, licence, gmp, eudamed, mhra } from '../../data/registry';
import { getLangFromUrl, useTranslations, localizePath, tpl } from '../../i18n/utils';
import { GROUP_URL } from '../../config';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const a = t.about;
---

<Base title={t.nav.about} description={t.meta.about}>
  <header class="container page-head">
    <p class="ph-eyebrow hero-fade d1">{a.eyebrow}</p>
    <h1><span class="hero-line"><span>{a.title}</span></span></h1>
    <p class="ph-sub hero-fade d2">{a.sub}</p>
  </header>

  <!-- 01 법인 신원 -->
  <section class="container section" id="entity">
    <div class="split">
      <div class="text" data-reveal-stagger>
        <p class="eyebrow"><span class="no">01</span> {a.s1Eyebrow}</p>
        <h2>{a.s1Title}</h2>
        <p>{tpl(a.s1P1, { n: licence.number, y: licence.since.slice(0, 4) })}</p>
        <p>{a.s1P2}</p>
      </div>
      <div data-reveal="right">
        <PhotoSlot
          src="/images/manufacturing-line-direction.webp"
          alt="Vial filling line inside the GANA R&D cleanroom in Seongnam"
          note="제조소 외관 또는 안내판 컷 — 2026-10-12 촬영분(재촬영: 외관·안내판)으로 교체"
        />
      </div>
    </div>
    <ul class="kv" data-reveal-stagger>
      <li><span class="k">{a.idK1}</span><span>{a.idV1}</span></li>
      <li><span class="k">{a.idK2}</span><span>{a.idV2}</span></li>
      <li><span class="k">{a.idK3}</span><span><a class="mono" href="tel:+82317330242">+82-31-733-0242</a></span></li>
    </ul>
  </section>

  <!-- 02 무엇을 만드는가 -->
  <section class="container section tight alt-wrap" id="makes">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">02</span> {a.s2Eyebrow}</p>
      <h2>{a.s2Title}</h2>
      <p class="lead">{a.s2P1}</p>
      <p class="lead">{a.s2P2}</p>
    </div>
    <div class="cards" data-reveal-stagger>
      <a class="card go" href={localizePath('/aesthetics', lang)}>
        <p class="who">{a.cardWho1}</p>
        <h3>{t.nav.aesthetics}</h3>
        <p>{a.card1}</p>
        <span class="link">{a.cardGo} <span class="arr">→</span></span>
      </a>
      <a class="card go" href={localizePath('/wound-care', lang)}>
        <p class="who">{a.cardWho2}</p>
        <h3>{t.nav.woundCare}</h3>
        <p>{a.card2}</p>
        <span class="link">{a.cardGo} <span class="arr">→</span></span>
      </a>
      <a class="card go" href={localizePath('/co-development', lang)}>
        <p class="who">{a.cardWho3}</p>
        <h3>{t.nav.coDevelopment}</h3>
        <p>{a.card3}</p>
        <span class="link">{a.cardGo} <span class="arr">→</span></span>
      </a>
    </div>
  </section>

  <!-- 03 자격 — 공개 조회 링크 -->
  <section class="container section tight" id="record">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">03</span> {a.s3Eyebrow}</p>
      <h2>{a.s3Title}</h2>
      <p class="lead">{a.s3Lead}</p>
    </div>
    <ul class="kv creds" data-reveal-stagger>
      <li><span class="k">{t.mfr.licenceK}</span><span>{tpl(t.mfr.licenceV, { n: licence.number, y: licence.since.slice(0, 4) })} <a class="link" href={licence.lookup} rel="noopener">{t.mfr.licenceLink} <span class="arr">→</span></a></span></li>
      <li><span class="k">{t.mfr.gmpK}</span><span>{tpl(t.mfr.gmpV, { n: gmp.number })} <a class="link" href={gmp.lookup} rel="noopener">{t.mfr.gmpLink} <span class="arr">→</span></a></span></li>
      <li><span class="k">{t.mfr.eudamedK}</span><span>{tpl(t.mfr.eudamedV, { n: eudamed.number })} <a class="link" href={eudamed.lookup} rel="noopener">{t.mfr.eudamedLink} <span class="arr">→</span></a></span></li>
      <li><span class="k">{t.mfr.mhraK}</span><span>{tpl(t.mfr.mhraV, { n: mhra.number })} <a class="link" href={mhra.lookup} rel="noopener">{t.mfr.mhraLink} <span class="arr">→</span></a></span></li>
      <li><span class="k">{a.regsK}</span><span>{tpl(a.regsV, { c: counts.published, j: counts.jurisdictions })} <a class="link" href={localizePath('/market-access', lang)}>{a.regsLink} <span class="arr">→</span></a></span></li>
    </ul>
  </section>

  <!-- 04 제조소 -->
  <section class="container section tight alt-wrap" id="site">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">04</span> {a.s4Eyebrow}</p>
      <h2>{a.s4Title}</h2>
      <p class="lead">{a.s4P1}</p>
    </div>
    <div class="photos" data-reveal-stagger>
      <PhotoSlot src="/images/formulation-process-direction.webp" ratio="4 / 3" alt="Formulation bench at the GANA R&D laboratory" note="클린룸 충전 라인 — 2026-10-12 촬영 5★ 컷(312·330·784 중)으로 교체" />
      <PhotoSlot ratio="4 / 3" note="복도 정면 또는 라벨링·포장 공정 — 재촬영 컷으로 교체" />
    </div>
  </section>

  <!-- 05 창업자 -->
  <section class="container section" id="founder">
    <div class="split">
      <div class="text" data-reveal-stagger>
        <p class="eyebrow"><span class="no">05</span> {a.s5Eyebrow}</p>
        <h2>{a.s5Title}</h2>
        <p>{a.s5P1}</p>
        <p>{a.s5P2}</p>
      </div>
      <div class="portrait" data-reveal="right">
        <PhotoSlot ratio="4 / 5" note="창업자 포트레이트 — 성남 제조소 배경, 자연광, 정면 또는 반측면 (샷리스트 6-1)" />
      </div>
    </div>
  </section>

  <!-- 06 연혁 -->
  <section class="container section tight alt-wrap" id="timeline">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">06</span> {a.s6Eyebrow}</p>
      <h2>{a.s6Title}</h2>
    </div>
    <ol class="timeline" data-reveal-stagger>
      {a.timeline.map((e) => (
        <li><span class="y mono">{e.t}</span><span class="d">{e.d}</span></li>
      ))}
    </ol>
  </section>

  <!-- 07 Dr. Park Group 관계 — "함께 쓰는 이름". 기업집단·자회사 표현 금지 -->
  <section class="container section tight" id="group">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">07</span> {a.s7Eyebrow}</p>
      <h2>{a.s7Title}</h2>
    </div>
    <div class="callout" data-reveal>
      {a.s7P1}
      {GROUP_URL && <> <a class="link" href={GROUP_URL} rel="noopener">{a.s7Link} <span class="arr">→</span></a></>}
    </div>
  </section>

  <section class="cta">
    <div class="container row" data-reveal>
      <div>
        <h2>{a.ctaTitle}</h2>
        <p>{a.ctaBody}</p>
      </div>
      <a class="btn on-dark" href={localizePath('/contact', lang)}>{t.common.contactCta}</a>
    </div>
  </section>
</Base>

<style>
  #entity .kv { margin-top: var(--s7); }
  .section-head .lead + .lead { margin-top: var(--s3); }
  .alt-wrap { position: relative; isolation: isolate; background: transparent; border-radius: 0; }
  .alt-wrap::before { content: ''; position: absolute; z-index: -1; inset: 0 50%; width: 100vw; transform: translateX(-50%); background: var(--paper-2); border-block: 1px solid var(--line); }
  .card.go { color: inherit; }
  .card.go:hover h3 { color: var(--accent); }
  .creds li span:last-child { display: flex; flex-wrap: wrap; gap: var(--s2) var(--s4); align-items: baseline; }
  .photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s5); }
  .portrait { max-width: 420px; justify-self: end; width: 100%; }
  .timeline { list-style: none; border-top: 1px solid var(--line-strong); }
  .timeline li { display: grid; grid-template-columns: 88px 1fr; gap: var(--s5); padding: var(--s4) 0; border-bottom: 1px solid var(--line); font-size: var(--text-sm); line-height: 1.6; }
  .timeline .y { color: var(--accent); font-size: var(--text-base); letter-spacing: .04em; }
  .timeline .d { color: var(--ink); max-width: 72ch; }
  @media (max-width: 900px) { .photos { grid-template-columns: 1fr; } .portrait { justify-self: start; max-width: 360px; } }
  @media (max-width: 640px) { .timeline li { grid-template-columns: 1fr; gap: var(--s1); } }
</style>
