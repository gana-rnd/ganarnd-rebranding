---
import Base from '../../layouts/Base.astro';
import { counts, marketAccess, published, licence, gmp, eudamed, mhra, authorityName, fmtDate, countBy, scopeOf, catLabel, umbrellaNote, productName, lookupHome } from '../../data/registry';
import { productForReg } from '../../data/products';
import { getLangFromUrl, useTranslations, localizePath, tpl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// 등재 → 제품 상세 페이지 (products.ts에 있는 제품만 링크가 생긴다)
const detailHref = (regId: string) => {
  const p = productForReg(regId);
  return p ? localizePath(`/${p.category}/${p.slug}`, lang) : null;
};

const supplyLabel: Record<string, { text: string; cls: string }> = {
  yes: { text: t.table.supplyYes, cls: 'ok' },
  'contract-manufacture-only': { text: t.table.supplyContract, cls: 'neutral' },
  no: { text: t.table.supplyNo, cls: 'warn' },
};
const byJurisdiction = countBy(published, 'jurisdiction');
// 기관별 입구는 registrations.json lookup_home, 등재별 딥링크는 각 등재의 lookup
const lookupUrl: Record<string, string> = lookupHome;
---

<Base title={t.nav.marketAccess} description={t.meta.marketAccess}>
  <header class="container page-head">
    <p class="ph-eyebrow hero-fade d1">{t.marketAccess.eyebrow}</p>
    <h1><span class="hero-line"><span>{t.marketAccess.title}</span></span></h1>
    <p class="ph-sub hero-fade d2">{t.marketAccess.sub}</p>
  </header>

  <!-- 시장접근 지도 -->
  <section class="container section">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">01</span> {t.marketAccess.s1Eyebrow}</p>
    </div>
    <div class="table-wrap" data-reveal>
      <table class="table stack">
        <thead><tr><th>{t.table.territory}</th><th>{t.table.status}</th><th>{t.table.basis}</th></tr></thead>
        <tbody>
          {marketAccess.map((m) => (
            <tr>
              <td>{t.jurisdictions[m.territory as keyof typeof t.jurisdictions] ?? m.territory}</td>
              <td><span class={`status ${supplyLabel[m.supply].cls}`}>{supplyLabel[m.supply].text}</span></td>
              <td class="muted">{t.coverage[m.territory as keyof typeof t.coverage] ?? `${m.basis}${m.note ? ` — ${m.note}` : ''}`}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 유통 파트너십 -->
  <section class="container section tight">
    <div class="prose" data-reveal-stagger>
      <p class="eyebrow"><span class="no">02</span> {t.marketAccess.s2Eyebrow}</p>
      <h2>{t.marketAccess.s2Title}</h2>
      <p>{t.marketAccess.s2P1}</p>
      <p>{t.marketAccess.s2P2}</p>
      <a class="btn" href={localizePath('/contact', lang)}>{t.marketAccess.s2Cta}</a>
    </div>
  </section>

  <!-- 제조자 자격 -->
  <section class="container section tight">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">03</span> {t.marketAccess.s3Eyebrow}</p>
      <h2>{t.marketAccess.s3Title}</h2>
    </div>
    <ul class="kv" data-reveal-stagger>
      <li><span class="k">{t.mfr.licenceK}</span><span>{tpl(t.mfr.licenceV, { n: licence.number, y: licence.since.slice(0, 4) })} · <a class="link" href={licence.lookup} rel="noopener">{t.mfr.licenceLink}</a></span></li>
      <li><span class="k">{t.mfr.gmpK}</span><span>{tpl(t.mfr.gmpV, { n: gmp.number })} · <a class="link" href={gmp.lookup} rel="noopener">{t.mfr.gmpLink}</a></span></li>
      <li><span class="k">{t.mfr.eudamedK}</span><span>{tpl(t.mfr.eudamedV, { n: eudamed.number })} · <a class="link" href={eudamed.lookup} rel="noopener">{t.mfr.eudamedLink}</a></span></li>
      <li><span class="k">{t.mfr.mhraK}</span><span>{tpl(t.mfr.mhraV, { n: mhra.number })} · <a class="link" href={mhra.lookup} rel="noopener">{t.mfr.mhraLink}</a></span></li>
    </ul>
  </section>

  <!-- 등재 자료실 -->
  <section class="container section">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">04</span> {t.marketAccess.s4Eyebrow}</p>
      <h2>{tpl(t.marketAccess.s4Title, { c: counts.published })}</h2>
      <p class="lead">{t.marketAccess.s4Lead}</p>
    </div>

    {Object.entries(byJurisdiction).map(([jur, count]) => {
      const items = published.filter((r) => r.jurisdiction === jur);
      return (
        <div class="group" data-reveal>
          <div class="group-head">
            <h3>{t.jurisdictions[jur as keyof typeof t.jurisdictions] ?? jur} · {authorityName[jur]} · {count}</h3>
            {lookupUrl[jur] && <a class="link" href={lookupUrl[jur]} rel="noopener">{t.marketAccess.publicLookup} <span class="arr">→</span></a>}
          </div>
          <div class="table-wrap">
            <table class="table">
              <thead><tr><th>{t.table.registration}</th><th>{t.table.product}</th><th>{t.table.category}</th><th>{t.table.granted}</th><th>{t.table.scopeClass}</th><th>{t.product.verify}</th></tr></thead>
              <tbody>
                {items.map((r) => (
                  <tr>
                    <td class="mono">{r.number}</td>
                    <td>{detailHref(r.id) ? <a class="plink" href={detailHref(r.id)!}>{productName(r, t.table.partnerBrand)}<span class="arr" aria-hidden="true">→</span></a> : productName(r, t.table.partnerBrand)}{umbrellaNote(r, lang) ? <span class="muted small"> — {umbrellaNote(r, lang)}</span> : null}</td>
                    <td>{catLabel(r, lang)}</td>
                    <td>{fmtDate(r.date, lang)}{r.valid_to ? ` — ${t.table.to} ${fmtDate(r.valid_to, lang)}` : r.term === 'indefinite' ? ` — ${t.table.indefinite}` : ''}</td>
                    <td>{[scopeOf(r) === 'export' ? t.table.export : scopeOf(r) === 'domestic' ? t.table.domestic : null, r.class ? tpl(t.table.classFmt, { c: r.class }) : null].filter(Boolean).join(' · ')}</td>
                    <td>{r.lookup ? <a class="link" href={r.lookup} rel="noopener" target="_blank">{t.product.register}<span class="arr">→</span></a> : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {jur === 'RU' && <p class="small muted regnote">{t.product.ruCertNote}</p>}
        </div>
      );
    })}
  </section>

  <!-- 진행 중 -->
  <section class="container section tight">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">05</span> {t.marketAccess.s5Eyebrow}</p>
      <h2>{t.marketAccess.s5Title}</h2>
    </div>
    <ul class="kv" data-reveal-stagger>
      <li><span class="k">{t.marketAccess.p1k}</span><span>{t.marketAccess.p1v}</span></li>
      <li><span class="k">{t.marketAccess.p2k}</span><span>{t.marketAccess.p2v}</span></li>
      <li><span class="k">{t.marketAccess.p3k}</span><span>{t.marketAccess.p3v}</span></li>
    </ul>
  </section>

  <section class="cta">
    <div class="container row" data-reveal>
      <div>
        <h2>{t.marketAccess.ctaTitle}</h2>
        <p>{t.marketAccess.ctaBody}</p>
      </div>
      <a class="btn on-dark" href={localizePath('/contact', lang)}>{t.marketAccess.ctaBtn}</a>
    </div>
  </section>
</Base>

<style>
  .prose { max-width: 900px; display: grid; grid-template-columns: minmax(0, .65fr) minmax(280px, .35fr); gap: var(--s5) var(--s8); align-items: start; }
  .prose .eyebrow, .prose h2 { grid-column: 1 / -1; }
  .prose p { color: var(--ink-2); }
  .prose .btn { grid-column: 2; grid-row: 3 / span 2; justify-self: start; }
  .group { display: grid; grid-template-columns: minmax(180px, .32fr) minmax(0, 1.68fr); gap: clamp(32px, 6vw, 92px); margin-bottom: var(--s9); padding-top: var(--s6); border-top: 1px solid var(--line-strong); }
  .group-head { position: sticky; top: 110px; align-self: start; display: grid; gap: var(--s4); }
  .group-head h3 { color: var(--ink); }
  .group .regnote { grid-column: 2; max-width: 72ch; margin-top: var(--s4); }
  .plink { font-weight: 600; color: var(--ink); border-bottom: 1px solid var(--line-strong); padding-bottom: 1px; transition: border-color 220ms var(--ease), color 220ms var(--ease); }
  .plink:hover { color: var(--accent-2); border-color: var(--accent); }
  .plink .arr { display: inline-block; margin-left: 5px; color: var(--accent-2); transition: transform 300ms var(--ease-out-expo); }
  .plink:hover .arr { transform: translateX(4px); }
  @media (max-width: 780px) { .prose, .group { grid-template-columns: 1fr; } .group .regnote { grid-column: 1; } .prose .btn { grid-column: 1; grid-row: auto; } .group-head { position: static; } }
</style>
