---
import Base from '../../layouts/Base.astro';
import { counts, marketAccess, licence, gmp, eudamed, mhra, featured, authorityName, fmtDate, scopeOf, catLabel } from '../../data/registry';
import { getLangFromUrl, useTranslations, localizePath, tpl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const supplyLabel: Record<string, { text: string; cls: string }> = {
  yes: { text: t.table.supplyYes, cls: 'ok' },
  'contract-manufacture-only': { text: t.table.supplyContract, cls: 'neutral' },
  no: { text: t.table.supplyNo, cls: 'warn' },
};
const jurisdictionsList = Object.keys(counts.byJurisdiction).map((j) => t.jurisdictions[j as keyof typeof t.jurisdictions] ?? j).join(' · ');

// 대표 제품 2종 — 등재 데이터는 registry.featured, 문구·사진은 여기서.
// GANA FILL은 보드 리뷰용 임시 렌더(캡션에 명시), GANA PATCH는 2021 카탈로그 실물 팩샷(흰 배경 → contain 프레임).
const productMeta = {
  fill: {
    img: '/images/gana-fill-syringes.webp',
    alt: 'GANA FILL hyaluronic acid dermal filler syringes',
    note: 'Product render — replace with GANA FILL packshot before public launch',
    contain: false,
    kicker: t.home.p1Kicker, body: t.home.p1Body, link: t.home.p1Link,
  },
  patch: {
    img: '/images/gana-patch-packshot.webp',
    alt: 'GANA PATCH hydrogel occlusive dressing — cartons and bottles labelled GANA R&D',
    note: '',
    contain: true,
    kicker: t.home.p2Kicker, body: t.home.p2Body, link: t.home.p2Link,
  },
};
const products = featured.map((p) => ({ ...p, ...productMeta[p.key] }));
// 등재 한 줄 요약: 품목 · 허가일 · 국내 판매 허가(해당 시). 수출 범위·총괄 비고는 각 제품 페이지 표에서.
// (주의: 프론트매터 안에서 t.table 의 수출 범위 키를 점 표기로 접근하면 Astro 컴파일러가 모듈 선언문으로 오인한다. 주석에도 그 단어를 쓰지 말 것)
const regMeta = (r: Record<string, any>) =>
  [catLabel(r, lang), fmtDate(r.date, lang), scopeOf(r) === 'domestic' ? t.table.domesticApproval : null].filter(Boolean).join(' · ');

// 크리덴셜 값 — 번역 템플릿({n}=등록번호, mono 서체 유지를 위해 분리 렌더)
const credDefs: { k: string; v: string; n: string; vars: Record<string, string | number> }[] = [
  { k: t.home.cred1k, v: t.home.cred1v, n: licence.number, vars: { y: licence.since.slice(0, 4) } },
  { k: t.home.cred2k, v: t.home.cred2v, n: gmp.number, vars: { issuer: gmp.issuer } },
  { k: t.home.cred3k, v: t.home.cred3v, n: eudamed.number, vars: {} },
  { k: t.home.cred4k, v: t.home.cred4v, n: mhra.number, vars: {} },
];
const creds = credDefs.map((c) => {
  const [before, after = ''] = tpl(c.v, c.vars).split('{n}');
  return { k: c.k, before, n: c.n, after };
});
---

<Base title="GANA R&D" hasHero>
  <!-- 1. 풀스크린 히어로 — 사진은 클린룸 촬영 방향 컷(임시). 시린지 렌더는 대표 제품 패널에서 쓰므로 중복을 피한다. -->
  <section class="hero">
    <div class="hero-media">
      <img src="/images/manufacturing-line-direction.webp" alt="Photography direction — cleanroom filling and inspection line at the GANA R&D site, to be replaced with site photography before public launch" />
      <div class="hero-shade" aria-hidden="true"></div>
    </div>
    <div class="container hero-inner">
      <p class="hero-eyebrow hero-fade d1">{t.home.heroEyebrow}</p>
      <h1 class="hero-title">
        <span class="hero-line"><span>{t.home.heroTitle1}</span></span>
        <span class="hero-line"><span>{t.home.heroTitle2}</span></span>
      </h1>
      <p class="hero-sub hero-fade d2">{t.home.heroSub}</p>
      <div class="hero-actions hero-fade d3">
        <a class="btn on-dark" href={localizePath('/market-access', lang)}>{t.home.heroCta}</a>
        <a class="hero-link" href={localizePath('/contact', lang)}>{t.common.contactCta} <span class="arr">→</span></a>
      </div>
    </div>
    <div class="container hero-chips hero-fade d3">
      <ul>
        {t.home.chips.map((c) => <li>{c}</li>)}
      </ul>
    </div>
    <div class="scroll-indicator on-hero" aria-hidden="true"><span class="label">{t.common.scroll}</span></div>
  </section>

  <!-- 2. 대표 제품 2종 — 회장 지시(2026-09-15): GANA FILL · GANA PATCH를 첫 페이지에 -->
  <section class="container section">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">01</span> {t.home.productsEyebrow}</p>
      <h2>{t.home.productsTitle}</h2>
      <p class="lead">{t.home.productsLead}</p>
    </div>
    <div class="products" data-reveal-stagger>
      {products.map((p) => (
        <article class="product">
          <a class:list={['visual', { contain: p.contain }]} href={localizePath(p.page, lang)} aria-label={p.name}>
            <img src={p.img} alt={p.alt} loading="lazy" />
          </a>
          {p.note && <p class="photo-note">{p.note}</p>}
          <p class="kicker">{p.kicker}</p>
          <h3>{p.name}</h3>
          <p class="body">{p.body}</p>
          <ul class="facts">
            {p.regs.map((r) => (
              <li>
                <span class="mono">{authorityName[r.jurisdiction] ?? r.jurisdiction} {r.number}</span>
                <span class="meta">{regMeta(r)}</span>
              </li>
            ))}
          </ul>
          <a class="link" href={localizePath(p.page, lang)}>{p.link} <span class="arr">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <!-- 3. 왜 우리인가 — 회사 한 문단 + 숫자 2개 + 검증 가능한 자격 (구 02·03·05 섹션을 하나로) -->
  <section class="dark section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><span class="no">02</span> {t.home.s2Eyebrow}</p>
        <h2>{t.home.s1Title}</h2>
        <p class="lead">{t.home.s1P1}</p>
      </div>
      <div class="stats two" data-reveal>
        <div class="stat"><div class="n" data-count={counts.published}>{counts.published}</div><div class="l">{t.home.stat1}</div></div>
        <div class="stat"><div class="n" data-count={counts.jurisdictions}>{counts.jurisdictions}</div><div class="l">{t.home.stat2} — {jurisdictionsList}</div></div>
      </div>
      <ul class="kv" data-reveal-stagger>
        {creds.map((c) => (
          <li><span class="k">{c.k}</span><span>{c.before}<span class="mono">{c.n}</span>{c.after}</span></li>
        ))}
        <li><span class="k">{t.home.cred6k}</span><span>{t.home.cred6v}</span></li>
      </ul>
    </div>
  </section>

  <!-- 4. 공동개발·제조 — 세 번째 고객군은 한 줄로 -->
  <section class="container section tight">
    <div class="codev" data-reveal>
      <p class="who">{t.home.card3Who}</p>
      <div>
        <h3>{t.home.card3Title}</h3>
        <p>{t.home.card3Body}</p>
      </div>
      <a class="link" href={localizePath('/co-development', lang)}>{t.home.card3Title} <span class="arr">→</span></a>
    </div>
  </section>

  <!-- 5. 시장접근 요약 -->
  <section class="container section tight">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">03</span> {t.home.s5Eyebrow}</p>
      <h2>{t.home.s5Title}</h2>
      <p class="lead">{t.home.s5Lead}</p>
    </div>
    <div class="table-wrap" data-reveal>
      <table class="table stack">
        <thead><tr><th>{t.table.territory}</th><th>{t.table.status}</th><th>{t.table.basis}</th></tr></thead>
        <tbody>
          {marketAccess.map((m) => (
            <tr>
              <td>{t.jurisdictions[m.territory as keyof typeof t.jurisdictions] ?? m.territory}</td>
              <td><span class={`status ${supplyLabel[m.supply].cls}`}>{supplyLabel[m.supply].text}</span></td>
              <td class="muted">{t.coverage[m.territory as keyof typeof t.coverage] ?? `${m.basis}${m.note ? ` — ${m.note}` : ''}`}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="margin-top: var(--s5)" data-reveal><a class="link" href={localizePath('/market-access', lang)}>{t.home.s5Link} <span class="arr">→</span></a></p>
  </section>

  <!-- 6. CTA -->
  <section class="cta">
    <div class="container row" data-reveal>
      <div>
        <h2>{t.home.ctaTitle}</h2>
        <p>{t.home.ctaBody}</p>
      </div>
      <a class="btn on-dark" href={localizePath('/contact', lang)}>{t.common.contactCta}</a>
    </div>
  </section>
</Base>

<style>
  /* ── 풀스크린 히어로 ── */
  .hero {
    position: relative;
    min-height: min(92vh, 980px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #fff;
    overflow: hidden;
    background: var(--navy);
  }
  .hero-media { position: absolute; inset: 0; }
  .hero-media img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  .hero-shade {
    position: absolute; inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(11, 31, 58, 0.42) 0%,
      rgba(11, 31, 58, 0.28) 30%,
      rgba(11, 31, 58, 0.62) 62%,
      rgba(11, 31, 58, 0.92) 100%
    );
  }
  .hero-inner { position: relative; width: 100%; max-width: var(--content-max); padding-bottom: var(--s6); padding-top: var(--s10); }
  .hero-inner > * { max-width: 100%; }
  .hero-eyebrow {
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: var(--s5);
  }
  .hero-title {
    font-size: var(--text-display);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.04;
    color: #fff;
    max-width: 14ch;
  }
  .hero-sub {
    margin-top: var(--s5);
    max-width: 56ch;
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.82);
  }
  .hero-actions { display: flex; align-items: center; gap: var(--s6); margin-top: var(--s7); flex-wrap: wrap; }
  .hero-link {
    color: #fff; font-weight: 600; font-size: var(--text-sm);
    display: inline-flex; align-items: center; gap: 6px;
    border-bottom: 1px solid rgba(255,255,255,.4); padding-bottom: 4px;
    transition: border-color 300ms var(--ease-out-expo);
  }
  .hero-link:hover { border-color: #fff; }
  .hero-link .arr { display: inline-block; transition: transform 350ms var(--ease-out-expo); }
  .hero-link:hover .arr { transform: translateX(5px); }

  .hero-chips { position: relative; width: 100%; max-width: var(--content-max); padding-bottom: var(--s7); }
  .hero-chips ul {
    list-style: none; display: flex; flex-wrap: wrap; gap: var(--s2); padding-right: 96px;
    border-top: 1px solid rgba(255, 255, 255, 0.22); padding-top: var(--s5);
  }
  .hero-chips li {
    font-size: var(--text-xs); letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    padding: 7px 14px;
    backdrop-filter: blur(6px);
    background: rgba(255, 255, 255, 0.06);
  }
  .scroll-indicator.on-hero { left: auto; right: var(--gutter); transform: none; bottom: 24px; background: rgba(255,255,255,0.25); }
  .scroll-indicator.on-hero::after { background: #fff; }
  .scroll-indicator.on-hero .label { color: rgba(255,255,255,0.7); }

  @media (max-width: 768px) {
    .hero { min-height: 88vh; }
    .hero-chips ul { gap: 6px; }
  }

  /* ── 대표 제품 2종 ── */
  .products { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s8) var(--s7); }
  .product { display: flex; flex-direction: column; gap: var(--s3); }
  .product .visual {
    display: block; aspect-ratio: 4 / 3;
    background: var(--paper-2); border-radius: 2px; overflow: hidden;
  }
  .product .visual img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out-expo); }
  .product .visual:hover img { transform: scale(1.035); }
  /* 흰 배경 팩샷: 회색 판 대신 흰 바탕 + 헤어라인 (aesthetics의 .visual.contain과 같은 처리) */
  .product .visual.contain { background: #fff; border: 1px solid var(--line); }
  .product .photo-note {
    font-size: 0.6875rem; line-height: 1.45; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-3); margin: 0 0 var(--s2);
  }
  .product .kicker { font-size: var(--text-sm); color: var(--ink-3); margin: 0; }
  .product h3 { font-size: var(--text-2xl); letter-spacing: -0.015em; color: var(--ink); }
  .product .body { color: var(--ink-2); max-width: 52ch; }
  .product .facts { list-style: none; border-top: 1px solid var(--ink); margin-top: var(--s2); }
  .product .facts li { display: grid; gap: 2px; padding: var(--s3) 0; border-bottom: 1px solid var(--line); font-size: var(--text-sm); }
  .product .facts .mono { color: var(--ink); }
  .product .facts .meta { color: var(--ink-3); font-size: var(--text-xs); }
  /* 두 패널의 등재 수가 달라도 링크는 같은 높이에 */
  .product .link { margin-top: auto; padding-top: var(--s3); }
  @media (max-width: 768px) {
    .products { grid-template-columns: 1fr; gap: var(--s8); }
  }

  /* ── 다크 '왜 우리인가' 블록: 숫자 2개 + 자격 목록 ── */
  .dark .lead { color: rgba(255, 255, 255, 0.78); }
  .stats.two { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 760px; margin-bottom: var(--s7); }
  .dark .kv { border-top-color: rgba(255, 255, 255, 0.16); }
  .dark .kv li { border-bottom-color: rgba(255, 255, 255, 0.16); color: #fff; }
  .dark .kv .k { color: rgba(255, 255, 255, 0.6); }

  /* ── 공동개발 한 줄 ── */
  .codev {
    display: grid; grid-template-columns: 280px minmax(0, 1fr) auto; gap: var(--s6); align-items: start;
    border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line); padding-block: var(--s6);
  }
  .codev .who { font-size: var(--text-sm); color: var(--ink-3); margin: 0; }
  .codev h3 { font-size: var(--text-xl); margin-bottom: var(--s2); }
  .codev p { font-size: var(--text-sm); color: var(--ink-2); max-width: 64ch; }
  .codev .link { white-space: nowrap; padding-top: 2px; }
  @media (max-width: 900px) {
    .codev { grid-template-columns: 1fr; gap: var(--s3); }
  }
</style>
