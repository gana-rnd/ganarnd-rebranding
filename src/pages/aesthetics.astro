---
import Base from '../layouts/Base.astro';
import { surface, chemistryGroups, authorityName, fmtDate, scopeOf, umbrellaNote, byId, productName } from '../data/registry';
import { getLangFromUrl, useTranslations, localizePath, tpl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const groups = chemistryGroups(surface);

// 성분 계열별 대표 허가 제품 팩샷(2021 카탈로그 실물, 상자 표기 = 등재 품목명). 등재가 게시에서 빠지면 카드도 빠진다.
// GANA PH는 KR 등재명에 위탁 브랜드(Belviso)가 붙어 있어 같은 제품의 RU 등재로 연결한다.
const lineup = [
  { id: 'ru-2024-22440', img: '/images/lineup-gana-booster.webp', alt: 'GANA BOOSTER — cross-linked hyaluronic acid, carton and syringe' },
  { id: 'ru-2024-22794', img: '/images/lineup-gana-ph.webp', alt: 'GANA PH — poly-L-lactic acid and hyaluronic acid filler, carton and syringe' },
  { id: 'kr-23-426', img: '/images/lineup-filler-x.webp', alt: 'Filler X — polycaprolactone and hyaluronic acid filler, carton and syringe' },
  { id: 'ru-2025-26344', img: '/images/lineup-gana-ch.webp', alt: 'GANA CH — calcium hydroxyapatite and hyaluronic acid filler, carton and syringe' },
  { id: 'kr-22-305', img: '/images/lineup-gana-pn.webp', alt: 'GANA PN — PDRN and hyaluronic acid, carton and syringes' },
]
  .map((l) => ({ ...l, reg: byId(l.id) }))
  .filter((l) => l.reg)
  .map((l) => ({ ...l, group: chemistryGroups([l.reg!])[0].name }));
---

<Base title={t.nav.aesthetics} description={t.meta.aesthetics}>
  <header class="container page-head">
    <p class="ph-eyebrow hero-fade d1">{t.aesthetics.eyebrow}</p>
    <h1><span class="hero-line"><span>{t.aesthetics.title}</span></span></h1>
    <p class="ph-sub hero-fade d2">{t.aesthetics.sub}</p>
  </header>

  <section class="container section">
    <div class="split">
      <div class="text" data-reveal-stagger>
        <p class="eyebrow"><span class="no">01</span> {t.aesthetics.s1Eyebrow}</p>
        <p>{t.aesthetics.s1P1}</p>
        <p>{t.aesthetics.s1P2}</p>
        <a class="btn" href={localizePath('/contact', lang)}>{t.aesthetics.s1Cta}</a>
      </div>
      <div class="visual contain zoom-hover" data-reveal="right"><img src="/images/filler-x-box.webp" alt="Filler X — polycaprolactone and hyaluronic acid dermal filler manufactured by GANA R&D" /></div>
    </div>
  </section>

  <section class="container section">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">02</span> {t.aesthetics.s2Eyebrow}</p>
      <h2>{t.aesthetics.s2Title}</h2>
      <p class="lead">{t.aesthetics.s2Lead}</p>
    </div>

    <ul class="lineup" data-reveal-stagger>
      {lineup.map((l) => (
        <li>
          <div class="shot"><img src={l.img} alt={l.alt} loading="lazy" /></div>
          <p class="chem">{l.group}</p>
          <p class="name">{productName(l.reg!, t.table.partnerBrand)}</p>
          <p class="reg mono">{authorityName[l.reg!.jurisdiction]} {l.reg!.number}</p>
          <p class="where">{t.jurisdictions[l.reg!.jurisdiction as keyof typeof t.jurisdictions] ?? l.reg!.jurisdiction}</p>
        </li>
      ))}
    </ul>

    {groups.map((g) => (
      <div class="group" data-reveal>
        <h3>{g.name}</h3>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>{t.table.product}</th><th>{t.table.jurisdiction}</th><th>{t.table.registration}</th><th>{t.table.granted}</th><th>{t.table.scope}</th></tr></thead>
            <tbody>
              {g.items.map((r) => (
                <tr>
                  <td>{productName(r, t.table.partnerBrand)}{umbrellaNote(r, lang) ? <span class="muted small"> — {umbrellaNote(r, lang)}</span> : null}</td>
                  <td>{t.jurisdictions[r.jurisdiction as keyof typeof t.jurisdictions] ?? r.jurisdiction} · {authorityName[r.jurisdiction]}</td>
                  <td class="mono">{r.number}</td>
                  <td>{fmtDate(r.date, lang)}</td>
                  <td>{scopeOf(r) === 'export' ? t.table.export : scopeOf(r) === 'domestic' ? t.table.domestic : (r.class ? tpl(t.table.classFmt, { c: r.class }) : '—')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}

    <div class="callout" data-reveal><b>{t.aesthetics.callout.split('.')[0]}.</b> {t.aesthetics.callout.split('. ').slice(1).join('. ')}</div>
  </section>

  <section class="cta">
    <div class="container row" data-reveal>
      <div>
        <h2>{t.aesthetics.ctaTitle}</h2>
        <p>{t.aesthetics.ctaBody}</p>
      </div>
      <a class="btn on-dark" href={localizePath('/contact', lang)}>{t.common.contactCta}</a>
    </div>
  </section>
</Base>

<style>
  .lineup { list-style: none; margin: 0 0 var(--s10); padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line); }
  .lineup li { min-width: 0; padding: 20px 16px 28px; border-right: 1px solid var(--line); transition: background 240ms var(--ease), transform 300ms var(--ease-out-expo); }
  .lineup li:first-child { padding-left: 0; }
  .lineup li:last-child { padding-right: 0; border-right: 0; }
  .lineup li:hover { background: var(--paper-2); transform: translateY(-3px); }
  .lineup .shot { aspect-ratio: 4 / 3; background: var(--paper-2); overflow: hidden; }
  .lineup .shot img { width: 100%; height: 100%; object-fit: contain; transition: transform 500ms var(--ease-out-expo); }
  .lineup li:hover .shot img { transform: scale(1.025); }
  .lineup p { margin: 0; }
  .lineup .chem { margin-top: var(--s4); font-size: var(--text-xs); letter-spacing: .1em; text-transform: uppercase; color: var(--accent-2); }
  .lineup .name { margin-top: var(--s1); font-weight: 600; color: var(--ink); }
  .lineup .reg { margin-top: var(--s2); font-size: var(--text-xs); color: var(--ink-2); }
  .lineup .where { font-size: var(--text-xs); color: var(--ink-3); }
  .group { display: grid; grid-template-columns: minmax(150px, .28fr) minmax(0, 1.72fr); gap: clamp(32px, 6vw, 92px); margin-bottom: var(--s9); padding-top: var(--s6); border-top: 1px solid var(--line-strong); }
  .group h3 { position: sticky; top: 110px; align-self: start; color: var(--ink); }
  @media (max-width: 1024px) { .lineup { grid-template-columns: repeat(3, minmax(0, 1fr)); } .lineup li:nth-child(3) { border-right: 0; } }
  @media (max-width: 780px) { .group { grid-template-columns: 1fr; gap: var(--s4); } .group h3 { position: static; } }
  @media (max-width: 640px) { .lineup { grid-template-columns: repeat(2, minmax(0, 1fr)); } .lineup li { padding: 16px 10px 22px; } .lineup li:nth-child(odd) { padding-left: 0; } .lineup li:nth-child(even) { padding-right: 0; border-right: 0; } }
</style>
