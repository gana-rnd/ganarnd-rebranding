---
// 에스테틱 제품 상세 — 본문은 components/ProductPage.astro, 데이터는 data/products.ts (category: 'aesthetics')
import ProductPage from '../../../components/ProductPage.astro';
import { products } from '../../../data/products';

export function getStaticPaths() {
  return products.filter((x) => x.category === 'aesthetics').map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
---

<ProductPage product={product} />
