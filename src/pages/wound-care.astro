---
import Base from '../layouts/Base.astro';
import { tissue, authorityName, fmtDate, scopeOf } from '../data/registry';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Base title={t.nav.woundCare} description="Hydrogel and foam wound dressings manufactured by GANA R&D — MFDS licensed, including domestic approval, and registered in Russia.">
  <header class="container page-head">
    <p class="ph-eyebrow hero-fade d1">{t.woundCare.eyebrow}</p>
    <h1><span class="hero-line"><span>{t.woundCare.title}</span></span></h1>
    <p class="ph-sub hero-fade d2">{t.woundCare.sub}</p>
    <div class="page-visual photo-trio hero-fade d3" data-reveal="scale">
      <img src="/images/gana-patch-3.webp" alt="GANA PATCH hydrogel dressing being placed on a prepared wound site" />
      <img src="/images/gana-patch-2.webp" alt="Foam wound dressing pressed into place with a gloved hand" />
      <img src="/images/gana-patch-4.webp" alt="Dressing secured with tape over the application site" />
    </div>
  </header>

  <section class="container section">
    <div class="split">
      <div class="text" data-reveal-stagger>
        <p class="eyebrow"><span class="no">01</span> {t.woundCare.s1Eyebrow}</p>
        <p>{t.woundCare.s1P1}</p>
        <p>{t.woundCare.s1P2}</p>
        <a class="btn" href={localizePath('/contact', lang)}>{t.woundCare.s1Cta}</a>
      </div>
      <div class="visual zoom-hover" data-reveal="right"><img src="/images/gana-patch-1.webp" alt="Application site prepared with antiseptic through a surgical drape, before dressing" /></div>
    </div>
  </section>

  <section class="container section">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">02</span> {t.woundCare.s2Eyebrow}</p>
      <h2>{t.woundCare.s2Title}</h2>
    </div>
    <div class="table-wrap" data-reveal>
      <table class="table">
        <thead><tr><th>{t.table.product}</th><th>{t.table.type}</th><th>{t.table.jurisdiction}</th><th>{t.table.registration}</th><th>{t.table.granted}</th><th>{t.table.scope}</th></tr></thead>
        <tbody>
          {tissue.map((r) => (
            <tr>
              <td>{r.product}</td>
              <td>{r.category_en ?? r.chemistry ?? ''}{r.class ? ` · ${r.class}` : ''}</td>
              <td>{t.jurisdictions[r.jurisdiction as keyof typeof t.jurisdictions] ?? r.jurisdiction} · {authorityName[r.jurisdiction]}</td>
              <td class="mono">{r.number}</td>
              <td>{fmtDate(r.date)}{r.valid_to ? ` — valid to ${fmtDate(r.valid_to)}` : ''}</td>
              <td>{scopeOf(r) === 'domestic' ? t.table.domesticApproval : scopeOf(r) === 'export' ? t.table.export : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="callout" style="margin-top: var(--s6)" data-reveal><b>{t.woundCare.callout.split('.')[0]}.</b> {t.woundCare.callout.split('. ').slice(1).join('. ')}</div>
  </section>

  <section class="cta">
    <div class="container row" data-reveal>
      <div>
        <h2>{t.woundCare.ctaTitle}</h2>
        <p>{t.woundCare.ctaBody}</p>
      </div>
      <a class="btn on-dark" href={localizePath('/contact', lang)}>{t.common.contactCta}</a>
    </div>
  </section>
</Base>

<style>
  .photo-trio { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 4px; aspect-ratio: auto; height: clamp(240px, 30vw, 420px); }
  .photo-trio img { height: 100%; width: 100%; object-fit: cover; }
  @media (max-width: 768px) {
    .photo-trio { grid-template-columns: 1fr; height: auto; aspect-ratio: 16 / 9; }
    .photo-trio img:not(:first-of-type) { display: none; }
  }
</style>
