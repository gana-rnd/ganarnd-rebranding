---
import Base from '../layouts/Base.astro';
import { tissue, jurisdictionName, authorityName, fmtDate } from '../data/registry';
---

<Base title="Wound Care" description="Hydrogel and foam wound dressings manufactured by GANA R&D — MFDS licensed, including domestic approval, and registered in Russia.">
  <header class="container page-head">
    <p class="ph-eyebrow hero-fade d1">Wound Care — for hospitals and medical distribution</p>
    <h1><span class="hero-line"><span>We already manufacture the device your market requires.</span></span></h1>
    <p class="ph-sub hero-fade d2">Hydrogel and foam wound dressings — MFDS licensed including domestic approval, and registered in Russia.</p>
    <div class="page-visual photo-trio hero-fade d3" data-reveal="scale">
      <img src="/images/gana-patch-3.webp" alt="GANA PATCH hydrogel dressing applied to skin" />
      <img src="/images/gana-patch-2.webp" alt="GANA PATCH held between fingers" />
      <img src="/images/gana-patch-4.webp" alt="GANA PATCH on the skin" />
    </div>
  </header>

  <section class="container section">
    <div class="split">
      <div class="text" data-reveal-stagger>
        <p class="eyebrow"><span class="no">01</span> The device line</p>
        <p>Chronic wound and pressure ulcer products are regulated medical devices, not cosmetics. They are prescribed, bought by hospitals and long-term care, and judged on clinical evidence.</p>
        <p>GANA R&amp;D is a licensed medical device manufacturer with wound dressings already registered in more than one jurisdiction — including the group's only domestic-sale approval in Korea — and the capability to manufacture under a partner's brand.</p>
        <a class="btn" href="/contact">Ask about wound care supply</a>
      </div>
      <div class="visual zoom-hover" data-reveal="right"><img src="/images/gana-patch-1.webp" alt="" /></div>
    </div>
  </section>

  <section class="container section">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="no">02</span> Registered products</p>
      <h2>GANA PATCH</h2>
    </div>
    <div class="table-wrap" data-reveal>
      <table class="table">
        <thead><tr><th>Product</th><th>Type</th><th>Jurisdiction</th><th>Registration</th><th>Granted</th><th>Scope</th></tr></thead>
        <tbody>
          {tissue.map((r) => (
            <tr>
              <td>{r.product}</td>
              <td>{r.chemistry}{r.class ? ` · Class ${r.class}` : ''}</td>
              <td>{jurisdictionName[r.jurisdiction]} · {authorityName[r.jurisdiction]}</td>
              <td class="mono">{r.number}</td>
              <td class="tabular">{fmtDate(r.date)}{r.valid_to ? ` — valid to ${fmtDate(r.valid_to)}` : ''}</td>
              <td>{r.export_only === false ? <span class="status ok">Domestic approval</span> : r.export_only === true ? 'Export' : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container section tight">
    <div class="callout" data-reveal>
      <b>Partnership models.</b> Contract manufacturing under partner brand, registration and dossier support, territorial supply agreements, co-development of next-generation dressings, and long-term supply.
    </div>
  </section>

  <section class="cta">
    <div class="container row" data-reveal>
      <div><h2>A regulated line, ready to supply.</h2><p>Registration certificates and technical documentation are available on request.</p></div>
      <a class="btn on-dark" href="/contact">Contact GANA R&amp;D</a>
    </div>
  </section>
</Base>

<style>
  .photo-trio { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 4px; aspect-ratio: auto; height: clamp(240px, 30vw, 420px); }
  .photo-trio img { height: 100%; width: 100%; object-fit: cover; }
  @media (max-width: 768px) {
    .photo-trio { grid-template-columns: 1fr; height: auto; aspect-ratio: 16 / 9; }
    .photo-trio img:not(:first-of-type) { display: none; }
  }
</style>
