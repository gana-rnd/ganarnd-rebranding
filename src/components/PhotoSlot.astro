---
interface Props {
  note: string;
  ratio?: string;
  src?: string;
  alt?: string;
  caption?: string;
}
const {
  note,
  ratio = '4 / 3',
  src,
  alt = '',
  caption,
} = Astro.props;
---

{src ? (
  <figure class="photo-direction">
    <div class="frame" style={`aspect-ratio: ${ratio};`}>
      <img src={src} alt={alt} loading="lazy" />
    </div>
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
) : (
  <div class="slot" style={`aspect-ratio: ${ratio};`} role="img" aria-label={note}>
    <span aria-hidden="true">GANA R&amp;D</span>
  </div>
)}

<style>
  .photo-direction { margin: 0; }
  .frame { position: relative; overflow: hidden; background: var(--paper-2); border-radius: var(--radius); box-shadow: var(--shadow-sm); }
  .frame::after { content: ''; position: absolute; inset: 0; border: 1px solid rgba(22,34,44,.08); border-radius: inherit; pointer-events: none; }
  .frame img { width: 100%; height: 100%; object-fit: cover; transition: transform 650ms var(--ease-out-expo); }
  .photo-direction:hover img { transform: scale(1.025); }
  figcaption { margin-top: var(--s3); font-size: var(--text-xs); line-height: 1.5; color: var(--ink-3); }
  .slot { display: grid; place-items: center; background: var(--paper-2); border: 1px solid var(--line); border-radius: var(--radius); color: var(--ink-3); }
  .slot span { font-family: var(--font-logo); font-size: var(--text-xl); letter-spacing: -.03em; }
</style>
