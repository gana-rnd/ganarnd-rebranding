---
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';
import { licence, gmp } from '../data/registry';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="container top">
    <div class="brand-block">
      <span class="footer-logo-frame"><img class="footer-logo" src="/images/brand/gana-rnd-official-logo-white.png" width="720" height="206" alt="GANA R&D" /></span>
      <p class="statement">{t.home.heroTitle1} {t.home.heroTitle2}</p>
      <p class="note">{t.footer.note}</p>
    </div>
    <div class="nav-block">
      <p class="h">{t.footer.company}</p>
      <ul>
        <li><a href={localizePath('/aesthetics', lang)}>{t.nav.aesthetics}</a></li>
        <li><a href={localizePath('/wound-care', lang)}>{t.nav.woundCare}</a></li>
        <li><a href={localizePath('/co-development', lang)}>{t.home.card3Title}</a></li>
        <li><a href={localizePath('/market-access', lang)}>{t.nav.marketAccess}</a></li>
        <li><a href={localizePath('/about', lang)}>{t.nav.about}</a></li>
        <li><a href={localizePath('/contact', lang)}>{t.nav.contact}</a></li>
      </ul>
    </div>
    <div class="site-block">
      <p class="h">{t.footer.site}</p>
      <address>
        {t.footer.legalName}<br />
        {t.footer.addr1}<br />
        {t.footer.addr2}<br />
        {t.footer.tel}
      </address>
    </div>
  </div>
  <div class="container credentials" aria-label="Manufacturer credentials">
    <span>MFDS {licence.number}</span>
    <span>GMP {gmp.number}</span>
    <span>Seongnam · Republic of Korea</span>
  </div>
  <div class="container base">
    <p>&copy; {year} GANA R&amp;D Co., Ltd.</p>
    <p>{t.footer.audience}</p>
  </div>
</footer>

<style>
  .ftr { background: #0b1c31; color: #bac4ca; padding-block: clamp(72px, 9vw, 120px) var(--s6); }
  .top { display: grid; grid-template-columns: minmax(0, 2.1fr) minmax(160px, .75fr) minmax(260px, 1fr); gap: clamp(48px, 8vw, 120px); }
  .brand-block { max-width: 580px; }
  .footer-logo-frame { display: inline-flex; align-items: center; }
  .footer-logo { display: block; width: clamp(146px, 12vw, 180px); height: auto; }
  .statement { margin-top: var(--s5); max-width: 18ch; color: #fff; font-size: var(--text-xl); font-weight: 500; line-height: 1.3; letter-spacing: -.035em; }
  .note { margin-top: var(--s5); max-width: 54ch; font-size: var(--text-sm); color: #98a7b0; }
  .h { margin-bottom: var(--s5); color: #fff; font-size: .69rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  ul { list-style: none; display: flex; flex-direction: column; gap: var(--s3); }
  a { width: fit-content; font-size: var(--text-sm); transition: color 180ms var(--ease); }
  a:hover { color: #fff; }
  address { font-style: normal; font-size: var(--text-sm); color: #bac4ca; }
  .credentials { display: flex; flex-wrap: wrap; gap: var(--s4) var(--s7); margin-top: var(--s8); padding-block: var(--s5); border-block: 1px solid rgba(255,255,255,.12); color: #d9dfe2; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .04em; text-transform: uppercase; }
  .base { display: flex; justify-content: space-between; gap: var(--s4); padding-top: var(--s5); color: #758792; font-size: var(--text-xs); }
  @media (max-width: 900px) { .top { grid-template-columns: 1fr 1fr; } .brand-block { grid-column: 1 / -1; } }
  @media (max-width: 640px) { .top { grid-template-columns: 1fr; } .brand-block { grid-column: auto; } .base { flex-direction: column; } }
</style>
