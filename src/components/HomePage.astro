<script>
  // 히어로 캐러셀: 5.5초마다 다음 장. 탭이 숨겨지면 멈추고, 줄인 모션 설정이면 자동 넘김 없음.
  const media = document.querySelector('[data-hero-carousel]');
  const track = media?.querySelector('.hero-track') as HTMLElement | null;
  if (media && track && track.children.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const n = track.children.length; let i = 0; let timer = 0;
    const imgs = Array.from(track.children) as HTMLImageElement[];
    // 화면 밖 lazy 이미지는 브라우저가 안 받아 두므로, 보여 줄 장과 그 다음 장을 미리 eager로 바꿔 둔다
    const prime = (k: number) => { for (const j of [k, k + 1]) imgs[(j + n) % n].loading = 'eager'; };
    const go = (k: number) => { i = (k + n) % n; prime(i); track.style.transform = `translateX(${-100 * i}%)`; };
    prime(0);
    const start = () => { stop(); timer = window.setInterval(() => go(i + 1), 5500); };
    const stop = () => { if (timer) window.clearInterval(timer); timer = 0; };
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    // 드래그·스와이프: 60px 이상 끌면 이전/다음 장. 클릭은 그대로(이동 거의 없으면 통과).
    const hero = media.closest('.hero') as HTMLElement; let x0: number | null = null; let moved = false;
    hero.addEventListener('pointerdown', (e: PointerEvent) => { if (e.button !== 0) return; x0 = e.clientX; moved = false; stop(); });
    hero.addEventListener('pointermove', (e: PointerEvent) => { if (x0 === null) return; if (Math.abs(e.clientX - x0) > 8) { moved = true; hero.classList.add('dragging'); } });
    const end = (e: PointerEvent) => { if (x0 === null) return; const dx = e.clientX - x0; x0 = null; hero.classList.remove('dragging'); if (Math.abs(dx) > 60) go(dx < 0 ? i + 1 : i - 1); start(); };
    hero.addEventListener('pointerup', end); hero.addEventListener('pointercancel', end); hero.addEventListener('pointerleave', (e: PointerEvent) => { if (x0 !== null) end(e); });
    hero.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
    start();
  }
</script>
