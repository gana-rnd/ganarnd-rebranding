---
import Base from '../layouts/Base.astro';
import { counts, marketAccess, licence, gmp, featured, authorityName, fmtDate, scopeOf, catLabel } from '../data/registry';
import { getLangFromUrl, useTranslations, localizePath, tpl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const supplyLabel: Record<string, { text: string; cls: string }> = {
  yes: { text: t.table.supplyYes, cls: 'ok' },
  'contract-manufacture-only': { text: t.table.supplyContract, cls: 'neutral' },
  no: { text: t.table.supplyNo, cls: 'warn' },
};
const productMeta = {
  fill: {
    // 2026 카탈로그 바이알 컷(GANA V·X 상자+분말 바이알) — 본문의 "동결건조 분말"과 맞는 사진. 재촬영 팩샷(R-P1)이 오면 교체
    img: '/images/catalogue/gana-fill.webp',
    alt: 'GANA FILL family — GANA V and GANA X cartons and freeze-dried PLLA powder vials',
    packshot: true,
    kicker: t.home.p1Kicker, body: t.home.p1Body, link: `GANA FILL · ${t.product.detailTitle}`,
  },
  patch: {
    // 2021 카탈로그 실물 팩샷(흰 배경) — .packshot 변형으로 contain + 흰 판
    img: '/images/gana-patch-packshot.webp',
    alt: 'GANA PATCH hydrogel occlusive dressing — cartons and bottles labelled GANA R&D',
    packshot: true,
    kicker: t.home.p2Kicker, body: t.home.p2Body, link: `GANA PATCH · ${t.product.detailTitle}`,
  },
};
const products = featured.map((p) => ({ ...p, ...productMeta[p.key] }));
const regMeta = (r: Record<string, any>) =>
  [catLabel(r, lang), fmtDate(r.date, lang), scopeOf(r) === 'domestic' ? t.table.domesticApproval : null].filter(Boolean).join(' · ');
const licenceCount = Number(licence.number.replace(/\D/g, ''));
const gmpYear = Number(gmp.valid_to.slice(0, 4));
// "active since 2014" — About 히어로와 같은 식으로 mfr.licenceV에서 번호 자리를 비워 만든다
const activeSince = tpl(t.mfr.licenceV, { n: '', y: licence.since.slice(0, 4) }).replace(/^\s*[—-]\s*/, '');
const validTo = t.table.validTo.charAt(0).toUpperCase() + t.table.validTo.slice(1);
// 히어로 캐러셀 6장 — 모바일은 1200px 변형을 받는다
const heroImgs = [1, 2, 3, 4, 5, 6].map((n) => ({ src: `/images/hero-${n}.webp`, srcset: `/images/hero-${n}-1200.webp 1200w, /images/hero-${n}.webp 2176w` }));
---

<Base title="GANA R&D" hasHero>
  <section class="hero">
    <!-- 장비 사진 가로 캐러셀 — 자동 넘김(5.5s). 2026-10-12 촬영 카메라 JPG(보정 전) 6장: 312 충전라인 · 440 HMI · 706 WFI · 1200 턴테이블 · 514 동결건조기 · 1054 바이알 -->
    <div class="hero-media" aria-hidden="true" data-hero-carousel>
      <!-- 1장은 즉시, 나머지는 lazy — 스크립트가 넘기기 전에 다음 장을 미리 eager로 바꿔 빈 슬라이드가 비치지 않게 한다 -->
      <div class="hero-track">
        {heroImgs.map((h, i) => (
          <img src={h.src} srcset={h.srcset} sizes="100vw" width="2176" height="1224" alt="" decoding="async" fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? undefined : 'lazy'} />
        ))}
      </div>
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="hero-eyebrow hero-fade d1"><span></span>{t.home.heroEyebrow}</p>
      <h1 class="hero-title">
        <span class="hero-line"><span>{t.home.heroTitle1}</span></span>
        <span class="hero-line"><span>{t.home.heroTitle2}</span></span>
      </h1>
      <p class="hero-sub hero-fade d2">{t.home.heroSub}</p>
      <div class="hero-actions hero-fade d3">
        <a class="btn on-dark" href={localizePath('/market-access', lang)}>{t.home.heroCta} <span aria-hidden="true">↗</span></a>
        <a class="hero-link" href={localizePath('/contact', lang)}>{t.common.contactCta} <span class="arr">→</span></a>
      </div>
    </div>
    <div class="scroll-indicator" aria-hidden="true"><span class="label">{t.common.scroll}</span></div>
  </section>

  <section class="container section products-section">
    <div class="section-intro" data-reveal>
      <div>
        <p class="eyebrow"><span class="no">01</span> {t.home.productsEyebrow}</p>
        <h2>{t.home.productsTitle}</h2>
      </div>
      <p class="lead">{t.home.productsLead}</p>
    </div>
    <div class="products" data-reveal-stagger>
      {products.map((p, index) => (
        <article class="product-card">
          <a class:list={['product-visual', { packshot: 'packshot' in p && p.packshot }]} href={localizePath(p.page, lang)} aria-label={p.name}>
            <img src={p.img} alt={p.alt} loading="lazy" />
            <span class="product-index">0{index + 1}</span>
            <span class="product-family">{p.kicker}</span>
          </a>
          <div class="product-copy">
            <div class="product-heading">
              <h3>{p.name}</h3>
              <span aria-hidden="true">↗</span>
            </div>
            <p class="body">{p.body}</p>
            <ul class="facts">
              {p.regs.map((r) => (
                <li>
                  <span class="mono">{authorityName[r.jurisdiction] ?? r.jurisdiction} {r.number}</span>
                  <span class="meta">{regMeta(r)}</span>
                </li>
              ))}
            </ul>
            <a class="link" href={localizePath(p.page, lang)}>{p.link} <span class="arr">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="codev-section">
    <div class="codev-visual" aria-hidden="true">
      <img src="/images/formulation-process-direction.webp" srcset="/images/formulation-process-direction-1200.webp 1200w, /images/formulation-process-direction.webp 2176w" sizes="(max-width: 1024px) 100vw, 76vw" width="2176" height="1632" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="container codev-inner">
      <div class="codev-copy" data-reveal="right">
        <p class="eyebrow"><span class="no">02</span> {t.home.card3Who}</p>
        <h2>{t.home.card3Title}</h2>
        <p>{t.home.card3Body}</p>
        <a class="btn ghost" href={localizePath('/co-development', lang)}>{t.home.card3Title} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="dark evidence">
    <div class="container">
      <div class="evidence-head" data-reveal>
        <div class="evidence-title">
          <p class="eyebrow"><span class="no">03</span> {t.home.s2Eyebrow}</p>
          <h2>{t.home.s1Title}</h2>
        </div>
        <div class="evidence-summary">
          <p class="lead">{t.home.s1P1}</p>
          <a class="evidence-link" href={localizePath('/market-access', lang)}>{t.home.s1Cta} <span>→</span></a>
        </div>
      </div>

      <div class="evidence-dashboard" data-reveal-stagger aria-label="Manufacturing credentials">
        <article class="proof-primary">
          <span class="proof-index">01</span>
          <div class="proof-primary-body">
            <strong class="proof-total tabular" data-count={counts.published}>{counts.published}</strong>
            <p>{t.home.stat1}</p>
          </div>
          </article>
        <div class="proof-ledger">
          <article class="proof-cell">
            <span class="proof-index">02</span>
            <strong class="proof-number tabular" data-count={counts.jurisdictions}>{counts.jurisdictions}</strong>
            <p>{t.home.stat2}</p>
          </article>
          <article class="proof-cell">
            <span class="proof-index">03</span>
            <strong class="proof-number mono"><span class="proof-prefix">No.</span> <span data-count={licenceCount}>{licenceCount}</span></strong>
            <p>{t.home.cred1k} · {activeSince}</p>
          </article>
          <article class="proof-cell">
            <span class="proof-index">04</span>
            <strong class="proof-number mono"><span class="proof-prefix">{validTo}</span> <span data-count={gmpYear}>{gmpYear}</span></strong>
            <p>{t.home.cred2k} · {gmp.number}</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="market-section section">
    <div class="container">
      <div class="section-intro" data-reveal>
        <div>
          <p class="eyebrow"><span class="no">04</span> {t.home.s5Eyebrow}</p>
          <h2>{t.home.s5Title}</h2>
        </div>
        <div class="intro-side">
          <p class="lead">{t.home.s5Lead}</p>
          <a class="link" href={localizePath('/market-access', lang)}>{t.home.s5Link} <span class="arr">→</span></a>
        </div>
      </div>
      <div class="table-wrap market-table" data-reveal>
        <table class="table stack">
          <thead><tr><th>{t.table.territory}</th><th>{t.table.status}</th><th>{t.table.basis}</th></tr></thead>
          <tbody>
            {marketAccess.map((m) => (
              <tr>
                <td>{t.jurisdictions[m.territory as keyof typeof t.jurisdictions] ?? m.territory}</td>
                <td><span class={`status ${supplyLabel[m.supply].cls}`}>{supplyLabel[m.supply].text}</span></td>
                <td class="muted">{t.coverage[m.territory as keyof typeof t.coverage] ?? `${m.basis}${m.note ? ` — ${m.note}` : ''}`}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container row" data-reveal>
      <div>
        <p class="cta-kicker">GANA R&amp;D · SEONGNAM</p>
        <h2>{t.home.ctaTitle}</h2>
        <p>{t.home.ctaBody}</p>
      </div>
      <a class="btn on-dark" href={localizePath('/contact', lang)}>{t.common.contactCta} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>

<style>
  /* 히어로 사진은 상단 흰 띠(고정 헤더) 바로 아래에서 시작한다 — 띠가 사진을 가리지 않게 */
  .hero { --hdr-h: 85px; margin-top: var(--hdr-h); position: relative; min-height: min(calc(88svh - var(--hdr-h)), 860px); display: flex; align-items: flex-end; color: #fff; overflow: hidden; background: var(--navy); }
  .hero-media, .hero-shade, .hero-grid { position: absolute; inset: 0; }
  .hero-track { display: flex; height: 100%; will-change: transform; transition: transform 1400ms cubic-bezier(.7, 0, .2, 1); }
  .hero-media img { flex: 0 0 100%; width: 100%; height: 100%; object-fit: cover; object-position: 50% 46%; animation: none !important; }
  @media (prefers-reduced-motion: reduce) { .hero-track { transition: none; } }
  .hero-shade { background: linear-gradient(90deg, rgba(7,23,44,.92) 0%, rgba(10,29,51,.68) 48%, rgba(10,29,51,.2) 82%), linear-gradient(0deg, rgba(7,23,44,.62), transparent 52%); }
  .hero-grid { opacity: .13; background-image: linear-gradient(rgba(255,255,255,.24) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.24) 1px, transparent 1px); background-size: 25% 100%, 100% 25%; mask-image: linear-gradient(90deg, #000, transparent 72%); }
  .hero { user-select: none; -webkit-user-select: none; cursor: grab; }
  .hero.dragging { cursor: grabbing; }
  .hero-inner { position: relative; z-index: 1; padding-top: clamp(64px, 7vw, 96px); padding-bottom: clamp(110px, 12vw, 160px); }
  .hero-eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: var(--s6); color: rgba(255,255,255,.72); font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .hero-eyebrow span { width: 34px; height: 1px; background: var(--accent); }
  .hero-title { max-width: 12ch; color: #fff; font-weight: 500; line-height: 1.02; letter-spacing: -.06em; }
  .hero-sub { margin-top: var(--s6); max-width: 60ch; color: rgba(255,255,255,.76); font-size: var(--text-lg); }
  .hero-actions { display: flex; align-items: center; gap: var(--s6); margin-top: var(--s7); flex-wrap: wrap; }
  .hero-link { display: inline-flex; align-items: center; gap: 8px; color: #fff; font-size: var(--text-sm); font-weight: 700; border-bottom: 1px solid rgba(255,255,255,.4); padding-bottom: 4px; }
  .hero-link .arr { transition: transform 260ms var(--ease-out-expo); }
  .hero-link:hover .arr { transform: translateX(5px); }
  .scroll-indicator { right: var(--gutter); bottom: 34px; }

  .section-intro { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(300px, .65fr); gap: var(--s8); align-items: end; margin-bottom: var(--s8); }
  .section-intro h2 { max-width: 13ch; }
  .section-intro .lead { justify-self: end; }
  .products { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s5); }
  .product-card { overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .product-visual { position: relative; display: block; aspect-ratio: 5 / 3.7; overflow: hidden; background: var(--paper-2); }
  .product-visual::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(14,33,57,.05), rgba(14,33,57,.2)); pointer-events: none; }
  .product-visual img { width: 100%; height: 100%; object-fit: cover; transition: transform 700ms var(--ease-out-expo); }
  .product-card:hover .product-visual img { transform: scale(1.025); }
  /* 흰 배경 팩샷: 잘리지 않게 contain, 어둡게 까는 오버레이는 빼고 번호는 잉크색으로 */
  .product-visual.packshot { background: #fff; }
  .product-visual.packshot img { object-fit: contain; }
  .product-visual.packshot::after { background: none; }
  .product-visual.packshot .product-index { color: var(--ink-3); }
  .product-index { position: absolute; z-index: 1; top: 20px; left: 22px; color: #fff; font-family: var(--font-mono); font-size: .7rem; letter-spacing: .08em; }
  .product-family { position: absolute; z-index: 1; right: 20px; bottom: 18px; max-width: 70%; padding: 8px 12px; border: 1px solid rgba(255,255,255,.35); border-radius: 999px; background: rgba(10,29,51,.52); backdrop-filter: blur(10px); color: #fff; font-size: .68rem; font-weight: 600; }
  .product-copy { display: flex; flex-direction: column; gap: var(--s4); padding: clamp(26px, 4vw, 44px); }
  .product-heading { display: flex; align-items: center; justify-content: space-between; gap: var(--s4); }
  .product-heading h3 { color: var(--ink); font-size: var(--text-2xl); font-weight: 500; }
  .product-heading > span { color: var(--accent); font-size: 1.25rem; }
  .product-copy .body { color: var(--ink-2); }
  .facts { list-style: none; margin-top: var(--s2); border-top: 1px solid var(--line-strong); }
  .facts li { display: grid; grid-template-columns: minmax(150px, .8fr) 1.4fr; gap: var(--s4); padding: 14px 0; border-bottom: 1px solid var(--line); font-size: var(--text-xs); }
  .facts .meta { color: var(--ink-3); }
  .product-copy .link { margin-top: var(--s3); }

  .evidence { position: relative; isolation: isolate; overflow: hidden; scroll-margin-top: 96px; padding-block: clamp(100px, 11vw, 168px); }
  .evidence::before { content: ''; position: absolute; z-index: -1; inset: 0; background: radial-gradient(circle at 84% 35%, rgba(36, 76, 102, .28), transparent 31%), linear-gradient(115deg, rgba(255,255,255,.025), transparent 44%); }
  .evidence::after { content: 'GANA R&D'; position: absolute; z-index: -1; right: -1vw; bottom: -5vw; color: rgba(255,255,255,.025); font-family: var(--font-logo); font-size: clamp(8rem, 18vw, 18rem); line-height: 1; white-space: nowrap; pointer-events: none; }
  .evidence-head { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(300px, .72fr); gap: clamp(48px, 9vw, 148px); align-items: end; padding-bottom: clamp(46px, 6vw, 84px); border-bottom: 1px solid rgba(255,255,255,.2); }
  .evidence-title h2 { max-width: 10ch; font-size: clamp(3rem, 5vw, 5.8rem); line-height: .98; letter-spacing: -.065em; }
  .evidence-summary { max-width: 500px; padding-bottom: 4px; }
  .evidence-summary .lead { color: rgba(255,255,255,.7); }
  .evidence-link { display: inline-flex; gap: 8px; margin-top: var(--s7); padding-bottom: 4px; border-bottom: 1px solid rgba(255,255,255,.35); color: #fff; font-size: var(--text-sm); font-weight: 700; }
  .evidence-dashboard { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(320px, .95fr) minmax(0, 1.35fr); border-bottom: 1px solid rgba(255,255,255,.2); }
  .proof-primary { position: relative; min-height: clamp(280px, 24vw, 340px); display: flex; flex-direction: column; padding: clamp(30px, 4.4vw, 64px); overflow: hidden; border-right: 1px solid rgba(255,255,255,.2); background: linear-gradient(145deg, rgba(255,255,255,.065), rgba(255,255,255,.01)); }
  .proof-primary::after { content: ''; position: absolute; width: 58%; aspect-ratio: 1; right: -20%; bottom: -38%; border: 1px solid rgba(255,255,255,.1); border-radius: 50%; box-shadow: 0 0 0 48px rgba(255,255,255,.025), 0 0 0 96px rgba(255,255,255,.014); }
  .proof-primary-body { position: relative; z-index: 1; display: flex; flex: 1; flex-direction: column; justify-content: flex-end; }
  .proof-index { color: var(--accent); font-family: var(--font-mono); font-size: .65rem; font-weight: 500; letter-spacing: .1em; }
  .proof-total { color: #fff; font-size: clamp(7rem, 11vw, 12rem); font-weight: 500; line-height: .76; letter-spacing: -.085em; }
  .proof-primary p { max-width: 26ch; margin-top: var(--s5); color: rgba(255,255,255,.6); font-size: var(--text-sm); line-height: 1.45; }
  .proof-ledger { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .proof-cell { min-height: clamp(280px, 24vw, 340px); display: flex; flex-direction: column; padding: clamp(26px, 3.3vw, 48px); border-right: 1px solid rgba(255,255,255,.2); }
  .proof-cell:last-child { border-right: 0; }
  .proof-number { margin-top: auto; color: #fff; font-size: clamp(3.25rem, 5vw, 5.5rem); font-weight: 500; line-height: .86; letter-spacing: -.07em; }
  .proof-number.mono { font-size: clamp(1.55rem, 2.5vw, 2.8rem); letter-spacing: -.055em; white-space: nowrap; }
  .proof-prefix { color: rgba(255,255,255,.57); font-family: var(--font); font-size: .63em; font-weight: 500; letter-spacing: -.02em; }
  .proof-cell p { min-height: 3.1em; margin-top: var(--s4); color: rgba(255,255,255,.54); font-size: .68rem; font-weight: 700; line-height: 1.45; letter-spacing: .075em; text-transform: uppercase; }

  .codev-section { position: relative; isolation: isolate; min-height: clamp(580px, 46vw, 720px); margin-bottom: clamp(88px, 10vw, 164px); overflow: hidden; background: var(--paper-2); }
  .codev-section::after { content: ''; position: absolute; z-index: 1; inset: 0; background: linear-gradient(90deg, rgba(245,247,246,0) 0%, rgba(245,247,246,.04) 36%, rgba(245,247,246,.74) 56%, #f5f7f6 72%, #f5f7f6 100%); pointer-events: none; }
  .codev-visual { position: absolute; z-index: 0; inset: 0; overflow: hidden; }
  .codev-visual img { width: 76vw; height: 100%; object-fit: cover; object-position: center 48%; transform: scale(1.015); }
  .codev-inner { position: relative; z-index: 2; min-height: inherit; display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(380px, .88fr); align-items: center; }
  .codev-copy { grid-column: 2; display: flex; flex-direction: column; align-items: flex-start; width: 100%; padding-block: clamp(72px, 9vw, 128px); padding-left: clamp(30px, 5vw, 84px); }
  .codev-copy h2 { max-width: 14ch; font-size: clamp(2.5rem, 4.7vw, 4.8rem); }
  .codev-copy > p:not(.eyebrow) { margin-top: var(--s5); color: var(--ink-2); }
  .codev-copy .btn { margin-top: var(--s7); }

  .market-section { background: var(--paper-2); border-top: 1px solid var(--line); }
  .intro-side { display: grid; gap: var(--s5); justify-items: start; }
  .market-table { box-shadow: none; }
  .market-table .table th { background: #fff; }
  .market-table .table td:first-child { font-weight: 700; }
  .cta-kicker { margin-bottom: var(--s4); color: var(--accent) !important; font-family: var(--font-mono); font-size: .67rem; font-weight: 500; letter-spacing: .13em; text-transform: uppercase; }

  @media (max-width: 1120px) { .hero { --hdr-h: 73px; } }
  @media (max-width: 1024px) {
    .evidence-head { gap: var(--s7); }
    .evidence-dashboard { grid-template-columns: minmax(280px, .86fr) minmax(0, 1.14fr); }
    .proof-primary, .proof-cell { min-height: 300px; }
    .proof-primary { padding: var(--s6); }
    .proof-cell { padding: var(--s5); }
    .proof-total { font-size: clamp(6rem, 11vw, 9rem); }
    .proof-number { font-size: clamp(2.8rem, 5vw, 4.5rem); }
    .proof-number.mono { font-size: clamp(1.35rem, 2.5vw, 2.1rem); }
    .codev-section { min-height: 760px; }
    .codev-section::after { background: linear-gradient(180deg, rgba(245,247,246,0) 0%, rgba(245,247,246,.05) 31%, rgba(245,247,246,.88) 52%, #f5f7f6 64%, #f5f7f6 100%); }
    .codev-visual img { width: 100%; height: 58%; object-position: center; }
    .codev-inner { grid-template-columns: 1fr; align-items: end; }
    .codev-copy { grid-column: 1; max-width: 720px; padding: 380px 0 72px; }
  }
  @media (max-width: 768px) {
    .hero { min-height: 820px; }
    .hero-shade { background: linear-gradient(90deg, rgba(7,23,44,.88), rgba(10,29,51,.48)), linear-gradient(0deg, rgba(7,23,44,.7), transparent 56%); }
    .hero-inner { padding-top: 140px; padding-bottom: 150px; }
    .hero-actions { align-items: flex-start; flex-direction: column; gap: var(--s5); }
