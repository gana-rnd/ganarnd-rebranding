---
// 헤더: 로고 좌 · 대메뉴 4 + Contact 우
const nav = [
  { href: '/aesthetics', label: 'Medical Aesthetics' },
  { href: '/wound-care', label: 'Wound Care' },
  { href: '/co-development', label: 'Co-development' },
  { href: '/market-access', label: 'Registrations & Market Access' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="hdr">
  <div class="container row">
    <a href="/" class="wordmark" aria-label="GANA R&D — home"><span class="g">GANA</span> <span class="r">R&amp;D</span></a>
    <nav aria-label="Primary">
      <ul>
        {nav.map((i) => (
          <li><a href={i.href} aria-current={path.startsWith(i.href) ? 'page' : undefined}>{i.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .hdr { background: var(--paper); position: sticky; top: 0; z-index: 20; }
  .row { display: flex; align-items: center; justify-content: space-between; min-height: 84px; }
  nav ul { display: flex; gap: var(--s6); list-style: none; }
  nav a { font-size: var(--text-sm); font-weight: 500; color: var(--ink); padding-block: var(--s2); border-bottom: 2px solid transparent; transition: border-color var(--dur) var(--ease); }
  nav a:hover, nav a[aria-current='page'] { border-bottom-color: var(--accent); }
  @media (max-width: 1024px) {
    .row { flex-direction: column; align-items: flex-start; gap: var(--s3); padding-block: var(--s4); }
    nav ul { flex-wrap: wrap; gap: var(--s4) var(--s5); }
  }
</style>
