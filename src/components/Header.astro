---
import { getLangFromUrl, useTranslations, localizePath, stripLangFromPath, languages } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = stripLangFromPath(Astro.url.pathname);
const nav = [
  { href: '/aesthetics', label: t.nav.aesthetics },
  { href: '/wound-care', label: t.nav.woundCare },
  { href: '/co-development', label: t.nav.coDevelopment },
  { href: '/market-access', label: t.nav.marketAccess },
  { href: '/about', label: t.nav.about },
  { href: '/contact', label: t.nav.contact, cta: true },
];
const primaryLabel: Record<string, string> = {
  en: 'Primary navigation', zh: '主导航', es: 'Navegación principal',
  th: 'เมนูหลัก', vi: 'Điều hướng chính', ru: 'Основная навигация',
};
const languageLabel: Record<string, string> = {
  en: 'Language', zh: '选择语言', es: 'Seleccionar idioma',
  th: 'เลือกภาษา', vi: 'Chọn ngôn ngữ', ru: 'Выбрать язык',
};
---

<header class="hdr">
  <div class="container row">
    <a href={localizePath('/', lang)} class="brand" aria-label="GANA R&D — home">
      <span class="brand-logo-frame">
        <img class="brand-logo on-light" src="/images/brand/gana-rnd-official-logo.png" width="720" height="206" alt="" />
        <img class="brand-logo on-dark" src="/images/brand/gana-rnd-official-logo-white.png" width="720" height="206" alt="" />
      </span>
      <span class="brand-descriptor">Medical Device<br />Manufacturer</span>
    </a>
    <div class="right">
      <nav id="site-nav" aria-label={primaryLabel[lang] ?? primaryLabel.en}>
        <ul>
          {nav.map((i) => {
            const localized = localizePath(i.href, lang);
            return (
              <li class:list={{ 'nav-cta-item': i.cta }}>
                <a class:list={{ 'nav-link': true, 'nav-cta': i.cta }} href={localized} aria-current={currentPath.startsWith(i.href) ? 'page' : undefined}>{i.label}</a>
              </li>
            );
          })}
        </ul>
      </nav>
      <div class="lang-switch">
        <button class="lang-btn" type="button" aria-haspopup="menu" aria-expanded="false" aria-label={languageLabel[lang] ?? languageLabel.en}>
          <span>{languages.find((l) => l.code === lang)?.label}</span>
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <ul class="lang-menu" role="menu">
          {languages.map((l) => (
            <li role="none">
              <a role="menuitem" tabindex="-1" href={localizePath(currentPath, l.code)} class={l.code === lang ? 'active' : undefined} hreflang={l.code}>{l.name}</a>
            </li>
          ))}
        </ul>
      </div>
      <button class="menu-btn" type="button" aria-controls="site-nav" aria-expanded="false" aria-label={t.nav.menu}>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.92); border-bottom: 1px solid rgba(22,34,44,.08); transition: background 260ms var(--ease), box-shadow 260ms var(--ease), border-color 260ms var(--ease); }
  .row { display: flex; align-items: center; justify-content: space-between; min-height: 84px; }
  .brand { display: inline-flex; align-items: center; gap: 15px; flex: none; }
  /* 로고: 원본(짙은 잉크)과 같은 모양의 흰 반전판을 겹쳐 두고 배경에 따라 하나만 보인다 — 흰 판 없이 투명 */
  .brand-logo-frame { position: relative; display: inline-flex; align-items: center; justify-content: center; }
  .brand-logo { display: block; width: clamp(126px, 10.5vw, 156px); height: auto; transition: opacity 260ms var(--ease); }
  .brand-logo.on-dark { position: absolute; inset: 0; opacity: 0; }
  .brand-descriptor { padding-left: 15px; border-left: 1px solid var(--line-strong); font-size: .59rem; font-weight: 700; line-height: 1.35; letter-spacing: .13em; text-transform: uppercase; color: var(--ink-3); }
  .right { display: flex; align-items: center; gap: 24px; }
  nav ul { display: flex; align-items: center; gap: clamp(18px, 2vw, 34px); list-style: none; }
  .nav-link { position: relative; display: inline-flex; align-items: center; min-height: 42px; color: var(--ink); font-size: .82rem; font-weight: 600; letter-spacing: -.015em; }
  .nav-link:not(.nav-cta)::after { content: ''; position: absolute; left: 0; right: 0; bottom: 4px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform 300ms var(--ease-out-expo); }
  .nav-link:hover::after, .nav-link[aria-current='page']::after { transform: scaleX(1); transform-origin: left; }
  .nav-cta { min-height: 40px; padding-inline: 18px; border: 1px solid rgba(22,34,44,.35); border-radius: 999px; transition: color 220ms var(--ease), background 220ms var(--ease), border-color 220ms var(--ease); }
  .nav-cta:hover, .nav-cta[aria-current='page'] { color: #fff; background: var(--ink); border-color: var(--ink); }

  .lang-switch { position: relative; z-index: 30; }
  .lang-btn { display: inline-flex; align-items: center; gap: 7px; min-height: 40px; padding: 0 13px; color: var(--ink-2); background: transparent; border: 0; border-radius: 999px; font-size: var(--text-xs); font-weight: 700; letter-spacing: .08em; cursor: pointer; transition: color 180ms var(--ease), background 180ms var(--ease); }
  .lang-btn:hover, .lang-switch.open .lang-btn { color: var(--ink); background: var(--paper-2); }
  .lang-btn svg { transition: transform 200ms var(--ease); }
  .lang-switch.open .lang-btn svg { transform: rotate(180deg); }
  .lang-menu { position: absolute; right: 0; top: calc(100% + 10px); width: 184px; list-style: none; background: rgba(255,255,255,.98); border: 1px solid var(--line); border-radius: var(--radius); padding: 8px; box-shadow: var(--shadow-lg); display: none; }
  .lang-switch.open .lang-menu { display: block; }
  .lang-menu a { display: flex; align-items: center; justify-content: space-between; min-height: 40px; padding: 8px 12px; border-radius: 8px; color: var(--ink); font-size: var(--text-sm); transition: background 180ms var(--ease); }
  .lang-menu a:hover, .lang-menu a:focus-visible { background: var(--paper-2); }
  .lang-menu a.active { color: var(--accent-2); font-weight: 700; }
  .lang-menu a.active::after { content: '•'; color: var(--accent); }

  .menu-btn { display: none; width: 42px; height: 42px; align-items: center; justify-content: center; background: transparent; border: 0; border-radius: 50%; cursor: pointer; }
  .bars { display: block; width: 22px; }
  .bars i { display: block; height: 1.5px; width: 100%; background: currentColor; transition: transform 260ms var(--ease-out-expo); }
  .bars i + i { margin-top: 7px; }
  .hdr.nav-open .bars i:first-child { transform: translateY(4.25px) rotate(45deg); }
  .hdr.nav-open .bars i:last-child { transform: translateY(-4.25px) rotate(-45deg); }

  body.has-hero .hdr { position: fixed; left: 0; right: 0; max-width: var(--site-max); margin-inline: auto; }
  /* 히어로 위 상단 띠: 흰 유리(78%) + 블러. 띠가 밝아지므로 로고·메뉴는 원래 짙은 색 그대로 둔다 */
  body.has-hero .hdr:not(.is-scrolled):not(.nav-open) { background: rgba(255,255,255,.78); -webkit-backdrop-filter: blur(16px) saturate(150%); backdrop-filter: blur(16px) saturate(150%); border-color: rgba(22,34,44,.08); }
  body.has-hero .hdr:not(.is-scrolled):not(.nav-open) .brand-descriptor { color: var(--ink-2); border-color: rgba(22,34,44,.28); }
  .hdr.is-scrolled { background: rgba(255,255,255,.9); -webkit-backdrop-filter: blur(18px) saturate(160%); backdrop-filter: blur(18px) saturate(160%); box-shadow: 0 8px 30px rgba(14,33,57,.06); }
  .hdr.is-scrolled .row { min-height: 70px; }

  @media (max-width: 1120px) {
    .row { min-height: 72px; }
    .brand-descriptor { display: none; }
    .menu-btn { display: inline-flex; }
    .right { gap: 8px; }
    nav { position: absolute; left: 0; right: 0; top: 100%; display: none; padding: 0 var(--gutter) var(--s6); background: rgba(255,255,255,.98); border-bottom: 1px solid var(--line); box-shadow: 0 24px 50px rgba(14,33,57,.12); }
    .hdr.nav-open nav { display: block; }
    nav ul { flex-direction: column; align-items: stretch; gap: 0; padding-top: var(--s3); }
    .nav-link { width: 100%; min-height: 58px; border-bottom: 1px solid var(--line); color: var(--ink) !important; font-size: 1.05rem; }
    .nav-link::after { content: none !important; }
    .nav-cta { margin-top: var(--s4); justify-content: center; border: 1px solid var(--ink); border-radius: 999px; background: var(--ink); color: #fff !important; }
    .hdr.nav-open { background: #fff; border-color: var(--line); }
    body.has-hero .hdr.nav-open .menu-btn { color: var(--ink); }
  }
  @media (max-width: 420px) {

    .brand-logo { width: 118px; }
    .lang-btn { padding-inline: 9px; }
  }
</style>

<script>
  const closeLang = () => {
    document.querySelectorAll('.lang-switch.open').forEach((el) => {
      el.classList.remove('open');
      el.querySelector('.lang-btn')?.setAttribute('aria-expanded', 'false');
    });
  };
  const hdr = document.querySelector('.hdr');
  const menuBtn = document.querySelector('.menu-btn');
  const closeNav = () => {
    if (!hdr?.classList.contains('nav-open')) return;
    hdr.classList.remove('nav-open');
    menuBtn?.setAttribute('aria-expanded', 'false');
  };
  document.querySelectorAll('.lang-switch').forEach((el) => {
    const btn = el.querySelector<HTMLButtonElement>('.lang-btn');
    const items = Array.from(el.querySelectorAll<HTMLAnchorElement>('[role="menuitem"]'));
    const openMenu = () => {
      closeNav();
      el.classList.add('open');
      btn?.setAttribute('aria-expanded', 'true');
    };
    btn?.addEventListener('click', (event) => {
      event.stopPropagation();
      const wasOpen = el.classList.contains('open');
      closeLang();
      if (!wasOpen) openMenu();
    });
    btn?.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key !== 'ArrowDown') return;
      event.preventDefault();
      openMenu();
      items[0]?.focus();
    });
    el.addEventListener('keydown', (event) => {
      const keyEvent = event as KeyboardEvent;
      const active = document.activeElement as HTMLAnchorElement | null;
      const index = active ? items.indexOf(active) : -1;
      if (keyEvent.key === 'Escape') {
        closeLang();
        btn?.focus();
      } else if (keyEvent.key === 'ArrowDown') {
        keyEvent.preventDefault();
        items[(index + 1 + items.length) % items.length]?.focus();
      } else if (keyEvent.key === 'ArrowUp') {
        keyEvent.preventDefault();
        items[(index - 1 + items.length) % items.length]?.focus();
      }
    });
  });
  document.addEventListener('click', closeLang);
  menuBtn?.addEventListener('click', (event) => {
    event.stopPropagation();
    closeLang();
    const open = hdr?.classList.toggle('nav-open') ?? false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (event) => {
    if (hdr && event.target instanceof Node && !hdr.contains(event.target)) closeNav();
  });
  document.querySelectorAll('#site-nav a').forEach((link) => link.addEventListener('click', closeNav));
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const navWasOpen = hdr?.classList.contains('nav-open');
    closeLang();
    closeNav();
    if (navWasOpen && menuBtn instanceof HTMLElement) menuBtn.focus();
  });
</script>
