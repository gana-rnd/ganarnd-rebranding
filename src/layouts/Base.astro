---
import '../styles/global.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, stripLangFromPath, localizePath, languages } from '../i18n/utils';

interface Props { title: string; description?: string; hasHero?: boolean; }
const {
  title,
  description = 'GANA R&D Co., Ltd. — licensed medical device manufacturer in Seongnam, Korea. Dermal fillers, wound dressings and contract manufacturing, with registration numbers a buyer can verify.',
  hasHero = false,
} = Astro.props;
const fullTitle =
  title === 'GANA R&D'
    ? 'GANA R&D — Licensed Medical Device Manufacturer, Korea'
    : `${title} — GANA R&D`;
const lang = getLangFromUrl(Astro.url);
const currentPath = stripLangFromPath(Astro.url.pathname);
const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalUrl = `${siteBase}${localizePath(currentPath, lang)}`;
const ogImage = `${siteBase}/images/og.jpg`;
const ogLocale: Record<string, string> = { en: 'en_US', ko: 'ko_KR', zh: 'zh_CN', es: 'es_ES', th: 'th_TH', vi: 'vi_VN', ru: 'ru_RU' };
// 한국어 페이지에만 한글 서체(Noto Sans KR)를 추가로 싣는다. 라틴 글리프는 그대로 Manrope.
const fontsHref = `https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500${lang === 'ko' ? '&family=Noto+Sans+KR:wght@400;500;600;700' : ''}&display=swap`;
const orgSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'GANA R&D Co., Ltd.',
  url: siteBase,
  telephone: '+82-31-733-0242',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '555 Dunchon-daero, Jungwon-gu',
    addressLocality: 'Seongnam-si',
    addressRegion: 'Gyeonggi-do',
    postalCode: '13215',
    addressCountry: 'KR',
  },
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- JS 활성 표시: 이 한 줄이 실행되어야만 motion.css의 숨김 초기 상태가 적용된다.
         JS가 아예 안 돌면 콘텐츠는 그대로 전부 보인다. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="GANA R&D" />
    <meta property="og:locale" content={ogLocale[lang] ?? 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GANA R&D dermal filler syringes" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={orgSchema} />
    <!-- hreflang alternate 링크 -->
    {languages.map((l) => (
      <link rel="alternate" hreflang={l.code} href={`${siteBase}${localizePath(currentPath, l.code)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteBase}${currentPath}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsHref} rel="stylesheet" />
  </head>
  <body class={hasHero ? 'has-hero' : undefined}>
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <!-- 모션 런타임: 인라인으로 이식해 외부 파일 로드 실패 가능성을 제거 -->
    <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ── 히어로 로드 시퀀스 ── */
      const boot = () => { document.body.classList.add('is-loaded'); };
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        requestAnimationFrame(boot);
      } else {
        window.addEventListener('DOMContentLoaded', boot, { once: true });
      }

      if (reduced) {
        document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach((el) => el.classList.add('is-in'));
        return;
      }

      /* ── 스크롤 리빌 (IntersectionObserver) ── */
      const revealIO = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              revealIO.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach((el) => revealIO.observe(el));

      /* ── 숫자 카운트업 ── */
      const easeOutExpo = (t) => (t >= 1 ? 1 : 1 - Math.pow(2, -10 * t));
      const animateCount = (el) => {
        const target = parseFloat(el.dataset.count);
        const dur = 1600;
        const start = performance.now();
        const tick = (now) => {
          const p = Math.min((now - start) / dur, 1);
          const val = Math.round(target * easeOutExpo(p));
          el.firstChild.nodeValue = String(val);
          if (p < 1) requestAnimationFrame(tick);
          else el.firstChild.nodeValue = String(target);
        };
        requestAnimationFrame(tick);
      };
      const countIO = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              animateCount(entry.target);
              countIO.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.4 }
      );
      document.querySelectorAll('[data-count]').forEach((el) => {
        if (el.firstChild && el.firstChild.nodeType === Node.TEXT_NODE) {
          el.firstChild.nodeValue = '0';
        }
        countIO.observe(el);
      });

      /* ── 헤더 스크롤 상태 ── */
      const hdr = document.querySelector('.hdr');
      if (hdr) {
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            hdr.classList.toggle('is-scrolled', window.scrollY > 24);
            ticking = false;
          });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      /* ── CTA 패럴랙스 글로우 ── */
      const cta = document.querySelector('.cta');
      if (cta) {
        let ctaTicking = false;
        const onCtaScroll = () => {
          if (ctaTicking) return;
          ctaTicking = true;
          requestAnimationFrame(() => {
            const rect = cta.getBoundingClientRect();
            const progress = (window.innerHeight - rect.top) / (window.innerHeight + rect.height);
            const clamped = Math.max(0, Math.min(1, progress));
            cta.style.setProperty('--cta-parallax', `${(clamped - 0.5) * 120}px`);
            ctaTicking = false;
          });
        };
        window.addEventListener('scroll', onCtaScroll, { passive: true });
        onCtaScroll();
      }

      /* ── 이미지 패럴랙스 (data-parallax) ── */
      const parallaxEls = document.querySelectorAll('[data-parallax]');
      if (parallaxEls.length) {
        let pTicking = false;
        const onPScroll = () => {
          if (pTicking) return;
          pTicking = true;
          requestAnimationFrame(() => {
            for (const el of parallaxEls) {
              const rect = el.getBoundingClientRect();
              if (rect.bottom < 0 || rect.top > window.innerHeight) continue;
              const speed = parseFloat(el.dataset.parallax) || 0.08;
              const offset = (rect.top + rect.height / 2 - window.innerHeight / 2) * speed;
              el.style.transform = `translateY(${offset.toFixed(1)}px)`;
            }
            pTicking = false;
          });
        };
        window.addEventListener('scroll', onPScroll, { passive: true });
        onPScroll();
      }
    })();
    </script>
    <style>
      .skip { position: absolute; left: -999px; }
      .skip:focus { left: var(--gutter); top: var(--s2); z-index: 30; background: var(--navy); color: #fff; padding: var(--s2) var(--s3); font-size: var(--text-sm); }
    </style>
  </body>
</html>
